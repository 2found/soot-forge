{
  "listen": "127.0.0.1:7789",
  "packs_dir": "packs",
  "data_dir": "data",
  "default_soot": "office",
  "soots": [
    "soots/office.json",
    "soots/ocr.json",
    "soots/tts.json",
    "soots/google-workspace.json",
    "soots/video-editor.json",
    "soots/image-gen.json"
  ],
  "pack_grants": {
    "office": {
      "credentials": {
        "FILE_ROOT": "workspace",
        "PYTHON_EXECUTABLE": "env:SOOT_MEDIA_PYTHON",
        "OFFICE_BINDING": "env:SOOT_OFFICE_BINDING"
      }
    },
    "ocr": {
      "credentials": {
        "FILE_ROOT": "workspace",
        "PYTHON_EXECUTABLE": "env:SOOT_MEDIA_PYTHON",
        "OCR_BINDING": "env:SOOT_OCR_BINDING"
      }
    },
    "tts": {
      "credentials": {
        "FILE_ROOT": "workspace",
        "PYTHON_EXECUTABLE": "env:SOOT_MEDIA_PYTHON",
        "TTS_BINDING": "env:SOOT_TTS_BINDING"
      }
    },
    "google-workspace": {
      "credentials": {
        "FILE_ROOT": "workspace",
        "PYTHON_EXECUTABLE": "env:SOOT_MEDIA_PYTHON"
      }
    },
    "video-editor": {
      "credentials": {
        "FILE_ROOT": "workspace",
        "PYTHON_EXECUTABLE": "env:SOOT_MEDIA_PYTHON",
        "VIDEO_BINDING": "env:SOOT_VIDEO_BINDING",
        "HYPERFRAMES_BINDING": "env:SOOT_HYPERFRAMES_BINDING"
      }
    },
    "image-gen": {
      "credentials": {
        "FILE_ROOT": "workspace",
        "PYTHON_EXECUTABLE": "env:SOOT_MEDIA_PYTHON",
        "IMAGE_GEN_BINDING": "env:SOOT_IMAGE_GEN_BINDING"
      }
    }
  },
  "execution": {
    "max_turns": 24,
    "max_tool_calls": 40,
    "tool_timeout": "6m",
    "subagents": 0,
    "advisor": false,
    "memory_consolidation": false,
    "todo_nudges": 0
  }
}
