{
  "listen": "127.0.0.1:7790",
  "packs_dir": "packs",
  "data_dir": "data",
  "product": "Lohi",
  "default_soot": "lohi-editor",
  "soots": [
    "soots/lohi-writer.json",
    "soots/lohi-editor.json",
    "soots/lohi-analyst.json",
    "soots/lohi-finance.json",
    "soots/lohi-radar.json",
    "soots/lohi-video.json"
  ],
  "approvals": {
    "marketing_claim": "auto"
  },
  "tool_hosts": {
    "lohi-video": {
      "workspace": "workspace"
    },
    "lohi-editor": {
      "workspace": "workspace"
    },
    "lohi-analyst": {
      "workspace": "workspace"
    },
    "lohi-finance": {
      "workspace": "workspace"
    }
  },
  "pack_grants": {
    "lohi-blog": {
      "env": [
        "LOHI_REPO",
        "LOHI_BLOG_REMOTE",
        "LOHI_CONNECTION",
        "PATH",
        "HOME",
        "SSH_AUTH_SOCK",
        "LOHI_BLOG_URL",
        "LOHI_API_URL"
      ]
    },
    "browser-use": {
      "env": [
        "PATH",
        "HOME",
        "SOOT_BROWSER_PERSISTENT_SOOTS"
      ],
      "credentials": {
        "FILE_ROOT": "workspace"
      }
    },
    "marketing": {
      "env": [
        "PRODUCT_API_URL",
        "YT_DLP_BIN",
        "PATH",
        "HOME"
      ],
      "credentials": {
        "FILE_ROOT": "workspace"
      }
    },
    "company-loop": {
      "env": [
        "SCOREBOARD_URL",
        "PRODUCT_REPO",
        "BBS_BIN",
        "BBS_TEAM_AGENT",
        "CS_RUNTIME_URL",
        "SUPPORT_QUEUE_URL",
        "RELEASE_TAGS",
        "LOOP_SOOT_BIN",
        "LOOP_SOOT_CONFIG",
        "PATH",
        "HOME"
      ]
    }
  },
  "schedules": [
    {
      "id": "marketing-plan",
      "name": "Lên bài blog và bài mạng xã hội",
      "soot": "lohi-writer",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "company-loop",
        "name": "topic_next",
        "input": {
          "chain": true
        }
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_plan found work. Follow the marketing-write skill, section \"The daily plan\": marketing_plan {} returns the brief. If it has a topic, write one article (draft_save, check, schedule). If it has social, write one short post per listed channel from the blog post (kind social, link exactly as given, brief.from = the blog post id), check, schedule. Nobody will answer a question: finish, and end with the one-line result.",
      "cron": "7 8-21/3 * * *",
      "then": [
        {
          "pack": "marketing",
          "tool": "plan",
          "label": "Lập kế hoạch bài",
          "input": {
            "wake": true,
            "channel": "blog-lohi",
            "facts_url": "https://api.lohi2.com/novel/v1/app-config",
            "catalog": {
              "feed": "https://api.lohi2.com/novel/discovery/feed",
              "genres": "https://api.lohi2.com/novel/discovery/genres",
              "search": "https://api.lohi2.com/novel/novels/search",
              "page": "https://lohi2.com/truyen/{slug}",
              "links": [
                "https://lohi2.com/ung-dung",
                "https://lohi2.com/dich-truyen"
              ]
            }
          },
          "input_from": "previous"
        },
        {
          "pack": "company-loop",
          "tool": "topic_sync",
          "label": "Đối chiếu chủ đề với bài",
          "input_from": "previous"
        }
      ]
    },
    {
      "id": "marketing-dispatch",
      "name": "Đăng bài đến giờ",
      "soot": "lohi-editor",
      "tool": {
        "pack": "marketing",
        "name": "due",
        "input": {
          "schedule": true,
          "skip": [
            "blog-lohi"
          ]
        }
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_due says something is due. Follow the marketing-dispatch skill: claim, publish (lohi-blog for the blog, marketing-browser-post for X, Facebook and Reddit), record, end in one line. Do not file Cần bạn items: the host raises them.",
      "cron": "*/10 7-22 * * *",
      "timezone": "Asia/Ho_Chi_Minh"
    },
    {
      "id": "marketing-blog",
      "name": "Đăng bài blog",
      "soot": "lohi-editor",
      "cron": "*/10 7-22 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "due",
        "input": {
          "schedule": true,
          "channel": "blog-lohi"
        }
      },
      "then": [
        {
          "pack": "marketing",
          "tool": "claim",
          "label": "Nhận lượt đăng",
          "input_from": "previous"
        },
        {
          "pack": "lohi-blog",
          "tool": "publish",
          "label": "Đăng lên blog",
          "input_from": "previous"
        },
        {
          "pack": "marketing",
          "tool": "record",
          "label": "Ghi bài đã đăng",
          "input_from": "previous"
        }
      ],
      "text": "The blog publish chain stopped on a failed step (its output is attached). If it has an intent_id and the post is not live, call marketing_fail {intent_id, status:\"failed\", reason}; otherwise do nothing. End with one line."
    },
    {
      "id": "marketing-probe",
      "name": "Kiểm tra đăng nhập mạng xã hội",
      "soot": "lohi-editor",
      "cron": "*/15 7-22 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "channels_probe",
        "input": {}
      },
      "then": [
        {
          "pack": "browser-use",
          "tool": "control",
          "label": "Mở trang kiểm tra",
          "input_from": "previous"
        },
        {
          "pack": "browser-use",
          "tool": "control",
          "label": "Đọc trang",
          "input": {
            "action": "command",
            "args": [
              "snapshot",
              "-i",
              "-c"
            ]
          }
        },
        {
          "pack": "marketing",
          "tool": "channels_probe",
          "label": "Quyết định đã đăng nhập chưa",
          "input_from": "previous"
        }
      ],
      "text": "The sign-in check could not open the browser. If the browser is not installed say so in one line (Nest: Cài trình duyệt); do nothing else."
    },
    {
      "id": "marketing-report",
      "name": "Báo cáo hằng ngày",
      "soot": "lohi-editor",
      "cron": "0 21 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "report",
        "input": {}
      },
      "text": "The daily report is read by a tool and kept for the Công ty page; no model is ever woken for it."
    },
    {
      "id": "marketing-channels",
      "name": "Kênh mạng xã hội",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "05:20",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "channels_setup",
        "input": {
          "product": "Lohi",
          "writer": "lohi-writer",
          "channels": [
            {
              "id": "x-lohi",
              "account": "lohi2com",
              "cap_per_day": 4,
              "spacing_min": 180,
              "reply_cap_per_day": 10,
              "rules": {
                "support_reply": "Bạn nhắn Hỗ trợ trong app Lohi nhé",
                "support_label": "Chuyển Hỗ trợ Lohi"
              }
            },
            {
              "id": "facebook-lohi",
              "account": "https://www.facebook.com/lohi2com",
              "cap_per_day": 2,
              "spacing_min": 360,
              "reply_cap_per_day": 10,
              "rules": {
                "support_reply": "Bạn nhắn Hỗ trợ trong app Lohi nhé",
                "support_label": "Chuyển Hỗ trợ Lohi"
              }
            },
            {
              "id": "reddit-lohi",
              "account": "lohi2com",
              "cap_per_day": 1,
              "spacing_min": 1440,
              "reply_cap_per_day": 5,
              "rules": {
                "support_reply": "Please message Support in the Lohi app.",
                "support_label": "Chuyển Hỗ trợ Lohi",
                "subreddits": [
                  "noveltranslations",
                  "ProgressionFantasy"
                ]
              }
            }
          ],
          "quiet_hours": {
            "from": "23:00",
            "to": "07:00",
            "tz": "Asia/Ho_Chi_Minh"
          },
          "stale_after_h": 6
        }
      },
      "text": "Create X, Facebook and Reddit channels the first time (paused until the founder signs in) and fill unset caps. It never unpauses a channel or overwrites an edit; nothing for a model to do."
    },
    {
      "id": "marketing-replies",
      "name": "Đọc phản hồi",
      "soot": "lohi-editor",
      "every": "2h",
      "tool": {
        "pack": "marketing",
        "name": "replies_sync",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_replies_sync found replies to classify or a channel to read. Follow the marketing-replies skill: read in the browser, classify, marketing_reply_save, answer only safe ones through check and schedule, raise the rest."
    },
    {
      "id": "marketing-gsc",
      "name": "Đọc Search Console",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "06:00",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "gsc_sync",
        "input": {
          "site": "sc-domain:lohi2.com",
          "days": 3
        }
      },
      "text": "Read yesterday's Search Console numbers for the published posts. A revoked sign-in is raised by the host as one Cần bạn item; nothing for a model to do."
    },
    {
      "id": "marketing-campaigns",
      "name": "Đọc số chiến dịch",
      "soot": "lohi-analyst",
      "every": "24h",
      "at": "07:00",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "campaign_report",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_campaign_report read the Lohi api for the running campaigns. Follow the marketing-measure skill, section Campaigns: record each outcomes item with the host outcome tool as given, update tokens_used for each tokens_due id, and tell the founder each tell item once."
    },
    {
      "id": "blog-ready",
      "name": "Kiểm tra điều kiện đăng blog",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "06:30",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "lohi-blog",
        "name": "ready",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "lohi-blog_ready found a prerequisite of publishing the blog that is missing. File its ask as one Cần bạn item with report_blocker (summary, missing, options as given) and end the turn."
    },
    {
      "id": "company-scoreboard",
      "name": "Đọc bảng số sản phẩm",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "06:15",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "company-loop",
        "name": "scoreboard_sync",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "Reads the product scoreboard with a tool. A refused key or readers waiting for a person are Cần bạn cards the host raises from the tool result (raise/settle); nothing here wakes a model unless a step fails."
    },
    {
      "id": "company-digest",
      "name": "Bản tin cơ hội hằng tuần",
      "soot": "lohi-analyst",
      "cron": "30 8 * * 1",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "company-loop",
        "name": "scoreboard_sync",
        "input": {
          "for_digest": true
        }
      },
      "then": [
        {
          "pack": "company-loop",
          "tool": "signals",
          "label": "Gom tín hiệu",
          "input": {}
        }
      ],
      "wake_when": {
        "notify": true
      },
      "text": "Weekly digest. Follow the company-digest skill: company-loop_signals {} gives the packet (scoreboard, cohorts, plans, support, feedback), rank at most five opportunities (content or product), company-loop_digest_save them, record its outcomes, end in one line (the host raises the opportunities card; do not file it). If a step failed (its output is attached), say the plain line in one sentence and stop."
    },
    {
      "id": "company-watch",
      "name": "Theo dõi đội dựng",
      "soot": "lohi-editor",
      "cron": "*/30 7-23 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "company-loop",
        "name": "team_watch",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "company-loop_team_watch found a requirement released. Record each item of outcomes with the host outcome tool exactly as given, then end with one line. Do nothing else."
    },
    {
      "id": "company-cards",
      "name": "Thẻ cơ hội chờ bạn chọn",
      "soot": "lohi-editor",
      "cron": "*/10 7-23 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "company-loop",
        "name": "opportunities_card",
        "input": {}
      },
      "text": "Keeps the opportunities card current: raised while an opportunity is proposed, closed when none is; nothing for a model to do."
    },
    {
      "id": "company-review",
      "name": "Chấm kết quả quyết định",
      "soot": "lohi-editor",
      "cron": "0 8 * * 1",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "company-loop",
        "name": "review",
        "input": {}
      },
      "text": "Fills actual_delta of decisions past check_after_days from the scoreboard and keeps the hit rate for the Công ty page; nothing for a model to do."
    },
    {
      "id": "radar-read",
      "name": "Đọc tín hiệu thị trường",
      "soot": "lohi-radar",
      "cron": "20 */3 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "radar_read",
        "input": {
          "schedule": true,
          "per_call": 2,
          "min_hours": 6,
          "wake_at": 6,
          "sources": [
            {
              "key": "reddit-webnovels",
              "kind": "reddit",
              "url": "https://www.reddit.com/r/noveltranslations/.rss"
            },
            {
              "key": "reddit-progfantasy",
              "kind": "reddit",
              "url": "https://www.reddit.com/r/ProgressionFantasy/.rss"
            },
            {
              "key": "reddit-webnovel",
              "kind": "reddit",
              "url": "https://www.reddit.com/r/webnovels/.rss"
            },
            {
              "key": "reddit-lightnovels",
              "kind": "reddit",
              "url": "https://www.reddit.com/r/LightNovels/.rss"
            },
            {
              "key": "reddit-vietnam-truyen",
              "kind": "reddit",
              "url": "https://www.reddit.com/r/Vietnam/search.rss?q=truy%E1%BB%87n+ch%E1%BB%AF&restrict_sr=1&sort=new"
            },
            {
              "key": "news-truyen-chu",
              "kind": "news",
              "url": "https://news.google.com/rss/search?q=truy%E1%BB%87n+ch%E1%BB%AF+online&hl=vi&gl=VN&ceid=VN:vi"
            },
            {
              "key": "news-truyen-dich",
              "kind": "news",
              "url": "https://news.google.com/rss/search?q=truy%E1%BB%87n+d%E1%BB%8Bch+web+novel&hl=vi&gl=VN&ceid=VN:vi"
            },
            {
              "key": "news-doc-truyen-app",
              "kind": "news",
              "url": "https://news.google.com/rss/search?q=%E1%BB%A9ng+d%E1%BB%A5ng+%C4%91%E1%BB%8Dc+truy%E1%BB%87n+audio&hl=vi&gl=VN&ceid=VN:vi"
            },
            {
              "key": "news-doi-thu",
              "kind": "news",
              "url": "https://news.google.com/rss/search?q=tangthuvien+OR+metruyenchu+OR+truyenfull+OR+wattpad&hl=vi&gl=VN&ceid=VN:vi"
            }
          ]
        }
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_radar_read kept new market signals (its answer says how many). Follow your mission: marketing_signals_list {state:\"new\"}, mark each kept, dismissed or used with marketing_signals_mark, end with one line naming the strongest angle. Read-only: never post or reply anywhere."
    },
    {
      "id": "marketing-video-stats",
      "name": "Đọc số TikTok và YouTube",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "07:30",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "video_stats",
        "input": {}
      },
      "text": "Reads public view, like and comment counts of the published videos with yt-dlp into the metrics table. No login, no model; without yt-dlp it keeps one plain need in the inputs view."
    },
    {
      "id": "company-health",
      "name": "Sức khoẻ vòng lặp",
      "soot": "lohi-analyst",
      "every": "24h",
      "at": "06:45",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "inputs_health",
        "input": {}
      },
      "then": [
        {
          "pack": "company-loop",
          "tool": "health_sync",
          "label": "Ghi sức khoẻ vòng lặp",
          "input_from": "previous"
        }
      ],
      "text": "Keeps the Vòng lặp section of the Công ty page (last run, tokens, starving inputs, founder effort). Tools only; nothing for a model to do."
    },
    {
      "id": "finance-report",
      "name": "Báo cáo tài chính tuần",
      "soot": "lohi-finance",
      "cron": "0 9 * * 1",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "company-loop",
        "name": "signals",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "company-loop_signals gave the week's numbers. Follow your mission: a short read-only Vietnamese report of revenue, plans and cohorts, 'chưa có' for a missing field, one warning at most. Never act on money."
    }
  ],
  "execution": {
    "max_turns": 16,
    "max_tool_calls": 30,
    "tool_timeout": "25m",
    "subagents": 0,
    "advisor": false,
    "memory_consolidation": false,
    "todo_nudges": 0
  }
}
