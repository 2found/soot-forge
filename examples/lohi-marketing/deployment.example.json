{
  "listen": "127.0.0.1:7790",
  "packs_dir": "packs",
  "data_dir": "data",
  "product": "Lohi",
  "default_soot": "lohi-editor",
  "soots": [
    "soots/lohi-radar.json",
    "soots/lohi-writer.json",
    "soots/lohi-editor.json"
  ],
  "approvals": {
    "marketing_claim": "auto"
  },
  "pack_grants": {
    "lohi-blog": {
      "env": [
        "LOHI_REPO",
        "PATH",
        "HOME",
        "SSH_AUTH_SOCK",
        "LOHI_BLOG_URL"
      ]
    },
    "browser-use": {
      "env": [
        "PATH",
        "HOME",
        "SOOT_BROWSER_PERSISTENT_SOOTS"
      ]
    }
  },
  "schedules": [
    {
      "id": "marketing-dispatch",
      "name": "Đăng bài đến giờ",
      "soot": "lohi-editor",
      "every": "10m",
      "tool": {
        "pack": "marketing",
        "name": "due",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_due says something is due or needs a person. Follow the marketing-dispatch skill: claim, publish (lohi-blog for the blog, marketing-browser-post for X, Facebook and Reddit), record, then one report_blocker (a sign-in is due.sign_in as is)."
    },
    {
      "id": "marketing-channels",
      "name": "Kênh mạng xã hội",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "05:20",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "channels_setup",
        "input": {
          "product": "Lohi",
          "channels": [
            {
              "id": "x-lohi",
              "account": "lohi2com",
              "cap_per_day": 4,
              "spacing_min": 180,
              "reply_cap_per_day": 10,
              "rules": {
                "support_reply": "Bạn nhắn Hỗ trợ trong app Lohi nhé",
                "support_label": "Chuyển Hỗ trợ Lohi"
              }
            },
            {
              "id": "facebook-lohi",
              "account": "https://www.facebook.com/lohi2com",
              "cap_per_day": 2,
              "spacing_min": 360,
              "reply_cap_per_day": 10,
              "rules": {
                "support_reply": "Bạn nhắn Hỗ trợ trong app Lohi nhé",
                "support_label": "Chuyển Hỗ trợ Lohi"
              }
            },
            {
              "id": "reddit-lohi",
              "account": "lohi2com",
              "cap_per_day": 1,
              "spacing_min": 1440,
              "reply_cap_per_day": 5,
              "rules": {
                "support_reply": "Please message Support in the Lohi app.",
                "support_label": "Chuyển Hỗ trợ Lohi",
                "subreddits": [
                  "noveltranslations",
                  "ProgressionFantasy"
                ]
              }
            }
          ],
          "quiet_hours": {
            "from": "23:00",
            "to": "07:00",
            "tz": "Asia/Ho_Chi_Minh"
          },
          "stale_after_h": 6
        }
      },
      "text": "Create X, Facebook and Reddit channels the first time (paused until the founder signs in) and fill unset caps. It never unpauses a channel or overwrites an edit; nothing for a model to do."
    },
    {
      "id": "marketing-replies",
      "name": "Đọc phản hồi",
      "soot": "lohi-editor",
      "every": "2h",
      "tool": {
        "pack": "marketing",
        "name": "replies_sync",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_replies_sync found replies to classify or a channel to read. Follow the marketing-replies skill: read in the browser, classify, marketing_reply_save, answer only safe ones through check and schedule, raise the rest."
    },
    {
      "id": "marketing-gsc",
      "name": "Đọc Search Console",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "06:00",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "gsc_sync",
        "input": {
          "site": "sc-domain:lohi2.com",
          "days": 3
        }
      },
      "text": "Read yesterday's Search Console numbers for the published posts. A revoked sign-in is raised by the host as one Cần bạn item; nothing for a model to do."
    },
    {
      "id": "marketing-facts",
      "name": "Đọc giá và ưu đãi",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "05:30",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "facts_sync",
        "input": {
          "url": "https://api.lohi2.com/novel/v1/app-config"
        }
      },
      "text": "Refresh the product facts the guard checks prices and offers against."
    }
  ],
  "execution": {
    "max_turns": 16,
    "max_tool_calls": 30,
    "tool_timeout": "25m",
    "subagents": 0,
    "advisor": false,
    "memory_consolidation": false,
    "todo_nudges": 0
  }
}
