{
  "listen": "127.0.0.1:7790",
  "packs_dir": "packs",
  "data_dir": "data",
  "product": "Lohi",
  "default_soot": "lohi-editor",
  "soots": [
    "soots/lohi-writer.json",
    "soots/lohi-editor.json",
    "soots/lohi-video.json"
  ],
  "approvals": {
    "marketing_claim": "auto"
  },
  "tool_hosts": {
    "lohi-video": {
      "workspace": "workspace"
    },
    "lohi-editor": {
      "workspace": "workspace"
    }
  },
  "pack_grants": {
    "lohi-blog": {
      "env": [
        "LOHI_REPO",
        "LOHI_BLOG_REMOTE",
        "LOHI_CONNECTION",
        "PATH",
        "HOME",
        "SSH_AUTH_SOCK",
        "LOHI_BLOG_URL",
        "LOHI_API_URL"
      ]
    },
    "browser-use": {
      "env": [
        "PATH",
        "HOME",
        "SOOT_BROWSER_PERSISTENT_SOOTS"
      ],
      "credentials": {
        "FILE_ROOT": "workspace"
      }
    },
    "marketing": {
      "env": [
        "PRODUCT_API_URL"
      ],
      "credentials": {
        "FILE_ROOT": "workspace"
      }
    }
  },
  "schedules": [
    {
      "id": "marketing-plan",
      "name": "Lên bài blog và bài mạng xã hội",
      "soot": "lohi-writer",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "plan",
        "input": {
          "wake": true,
          "channel": "blog-lohi",
          "facts_url": "https://api.lohi2.com/novel/v1/app-config",
          "catalog": {
            "feed": "https://api.lohi2.com/novel/discovery/feed",
            "genres": "https://api.lohi2.com/novel/discovery/genres",
            "search": "https://api.lohi2.com/novel/novels/search",
            "page": "https://lohi2.com/truyen/{slug}",
            "links": [
              "https://lohi2.com/ung-dung",
              "https://lohi2.com/dich-truyen"
            ]
          }
        }
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_plan found work. Follow the marketing-write skill, section \"The daily plan\": marketing_plan {} returns the brief. If it has a topic, write one article (draft_save, check, schedule). If it has social, write one short post per listed channel from the blog post (kind social, link exactly as given, brief.from = the blog post id), check, schedule. Nobody will answer a question: finish, and end with the one-line result.",
      "cron": "7 8-21/3 * * *"
    },
    {
      "id": "marketing-dispatch",
      "name": "Đăng bài đến giờ",
      "soot": "lohi-editor",
      "tool": {
        "pack": "marketing",
        "name": "due",
        "input": {
          "schedule": true,
          "skip": [
            "blog-lohi"
          ]
        }
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_due says something is due or needs a person that you have not raised. Follow the marketing-dispatch skill: claim, publish (lohi-blog for the blog, marketing-browser-post for X, Facebook and Reddit), record, then one report_blocker: due.ask as is.",
      "cron": "*/10 7-22 * * *",
      "timezone": "Asia/Ho_Chi_Minh"
    },
    {
      "id": "marketing-blog",
      "name": "Đăng bài blog",
      "soot": "lohi-editor",
      "cron": "*/10 7-22 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "due",
        "input": {
          "schedule": true,
          "channel": "blog-lohi"
        }
      },
      "then": [
        {
          "pack": "marketing",
          "tool": "claim",
          "label": "Nhận lượt đăng",
          "input_from": "previous"
        },
        {
          "pack": "lohi-blog",
          "tool": "publish",
          "label": "Đăng lên blog",
          "input_from": "previous"
        },
        {
          "pack": "marketing",
          "tool": "record",
          "label": "Ghi bài đã đăng",
          "input_from": "previous"
        }
      ],
      "text": "The blog publish chain stopped on a failed step (its output is attached). If it has an intent_id and the post is not live, call marketing_fail {intent_id, status:\"failed\", reason}; otherwise do nothing. End with one line."
    },
    {
      "id": "marketing-probe",
      "name": "Kiểm tra đăng nhập mạng xã hội",
      "soot": "lohi-editor",
      "cron": "*/15 7-22 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "channels_probe",
        "input": {}
      },
      "then": [
        {
          "pack": "browser-use",
          "tool": "control",
          "label": "Mở trang kiểm tra",
          "input_from": "previous"
        },
        {
          "pack": "browser-use",
          "tool": "control",
          "label": "Đọc trang",
          "input": {
            "action": "command",
            "args": [
              "snapshot",
              "-i",
              "-c"
            ]
          }
        },
        {
          "pack": "marketing",
          "tool": "channels_probe",
          "label": "Quyết định đã đăng nhập chưa",
          "input_from": "previous"
        }
      ],
      "text": "The sign-in check could not open the browser. If the browser is not installed say so in one line (Nest: Cài trình duyệt); do nothing else."
    },
    {
      "id": "marketing-report",
      "name": "Báo cáo hằng ngày",
      "soot": "lohi-editor",
      "cron": "0 21 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "report",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_report gave the daily report lines. Answer with those lines as they are, in plain Vietnamese, nothing added; no tool calls."
    },
    {
      "id": "marketing-channels",
      "name": "Kênh mạng xã hội",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "05:20",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "channels_setup",
        "input": {
          "product": "Lohi",
          "writer": "lohi-writer",
          "channels": [
            {
              "id": "x-lohi",
              "account": "lohi2com",
              "cap_per_day": 4,
              "spacing_min": 180,
              "reply_cap_per_day": 10,
              "rules": {
                "support_reply": "Bạn nhắn Hỗ trợ trong app Lohi nhé",
                "support_label": "Chuyển Hỗ trợ Lohi"
              }
            },
            {
              "id": "facebook-lohi",
              "account": "https://www.facebook.com/lohi2com",
              "cap_per_day": 2,
              "spacing_min": 360,
              "reply_cap_per_day": 10,
              "rules": {
                "support_reply": "Bạn nhắn Hỗ trợ trong app Lohi nhé",
                "support_label": "Chuyển Hỗ trợ Lohi"
              }
            },
            {
              "id": "reddit-lohi",
              "account": "lohi2com",
              "cap_per_day": 1,
              "spacing_min": 1440,
              "reply_cap_per_day": 5,
              "rules": {
                "support_reply": "Please message Support in the Lohi app.",
                "support_label": "Chuyển Hỗ trợ Lohi",
                "subreddits": [
                  "noveltranslations",
                  "ProgressionFantasy"
                ]
              }
            }
          ],
          "quiet_hours": {
            "from": "23:00",
            "to": "07:00",
            "tz": "Asia/Ho_Chi_Minh"
          },
          "stale_after_h": 6
        }
      },
      "text": "Create X, Facebook and Reddit channels the first time (paused until the founder signs in) and fill unset caps. It never unpauses a channel or overwrites an edit; nothing for a model to do."
    },
    {
      "id": "marketing-replies",
      "name": "Đọc phản hồi",
      "soot": "lohi-editor",
      "every": "2h",
      "tool": {
        "pack": "marketing",
        "name": "replies_sync",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_replies_sync found replies to classify or a channel to read. Follow the marketing-replies skill: read in the browser, classify, marketing_reply_save, answer only safe ones through check and schedule, raise the rest."
    },
    {
      "id": "marketing-gsc",
      "name": "Đọc Search Console",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "06:00",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "gsc_sync",
        "input": {
          "site": "sc-domain:lohi2.com",
          "days": 3
        }
      },
      "text": "Read yesterday's Search Console numbers for the published posts. A revoked sign-in is raised by the host as one Cần bạn item; nothing for a model to do."
    },
    {
      "id": "marketing-campaigns",
      "name": "Đọc số chiến dịch",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "07:00",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "marketing",
        "name": "campaign_report",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "marketing_campaign_report read the Lohi api for the running campaigns. Follow the marketing-measure skill, section Campaigns: record each outcomes item with the host outcome tool as given, update tokens_used for each tokens_due id, and tell the founder each tell item once."
    },
    {
      "id": "blog-ready",
      "name": "Kiểm tra điều kiện đăng blog",
      "soot": "lohi-editor",
      "every": "24h",
      "at": "06:30",
      "timezone": "Asia/Ho_Chi_Minh",
      "tool": {
        "pack": "lohi-blog",
        "name": "ready",
        "input": {}
      },
      "wake_when": {
        "notify": true
      },
      "text": "lohi-blog_ready found a prerequisite of publishing the blog that is missing. File its ask as one Cần bạn item with report_blocker (summary, missing, options as given) and end the turn."
    }
  ],
  "execution": {
    "max_turns": 16,
    "max_tool_calls": 30,
    "tool_timeout": "25m",
    "subagents": 0,
    "advisor": false,
    "memory_consolidation": false,
    "todo_nudges": 0
  }
}
