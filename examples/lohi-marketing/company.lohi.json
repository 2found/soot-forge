{
  "extends": "company-team",
  "id": "lohi",
  "name": "Lohi",
  "description": "Lohi as a company of teams. Soot ids are the recipe's; op-catalog is the lohi-catalog Soot that the lohi-ops pack ships; support and the desk run on the CS server and are declared here, not deployed by setup.",
  "teams": {
    "insight": {
      "soots": [
        {
          "id": "lohi-analyst",
          "role": "analyst"
        },
        {
          "id": "lohi-radar",
          "role": "radar"
        }
      ]
    },
    "marketing": {
      "soots": [
        {
          "id": "lohi-writer",
          "role": "writer"
        },
        {
          "id": "lohi-editor",
          "role": "publisher"
        }
      ],
      "daily_tokens": 250000
    },
    "cs": {
      "soots": [
        {
          "id": "support",
          "role": "answers readers"
        },
        {
          "id": "desk",
          "role": "sorts feedback"
        }
      ]
    },
    "financial": {
      "soots": [
        {
          "id": "lohi-finance",
          "role": "finance"
        }
      ]
    }
  },
  "add": [
    {
      "id": "op-catalog",
      "kind": "group",
      "group": "team-op",
      "soots": [
        {
          "id": "lohi-catalog",
          "role": "operator"
        }
      ],
      "takes_in": [
        {
          "from": "insight",
          "what": "approved catalog opportunities",
          "contract": "catalog-requests",
          "optional": true
        }
      ],
      "gives_out": [
        {
          "table": "findings",
          "pack": "lohi-ops",
          "fields": [
            "key",
            "check",
            "severity",
            "subject",
            "detail",
            "actionable",
            "first_seen",
            "last_seen"
          ],
          "note": "what the catalog, crawl and SEO checks found; the lohi-ops pack owns the table"
        }
      ],
      "decides": {
        "alone": [
          "routine catalog jobs inside the pack's limits"
        ],
        "with_founder": [
          "anything that deletes or republishes novels"
        ]
      },
      "daily_tokens": 80000,
      "escalates_when": [
        "a source is down",
        "a job would remove content"
      ],
      "slot": "examples/lohi-marketing/packs/lohi-ops"
    }
  ],
  "contracts": {
    "add": [
      {
        "id": "catalog-requests",
        "owner": "insight",
        "reader": "op-catalog",
        "table": "opportunities",
        "pack": "company-loop",
        "mode": "read",
        "fields": [
          "ref",
          "title",
          "kind",
          "state"
        ],
        "optional": true
      }
    ]
  }
}
