{
  "api_version": "soot-forge/company-template/v1",
  "id": "company-team",
  "name": "Company",
  "description": "Một công ty gồm các nhóm, mỗi nhóm là một giao diện: nhận gì, giao ra gì, tự quyết gì hay quyết cùng người sáng lập, ngân sách token mỗi ngày và khi nào báo bạn. Thêm, bớt hay đổi tên nhóm, hoặc sửa hợp đồng, trong một tệp overlay; không cần sửa mã.",
  "daily_token_ceiling": 550000,
  "teams": [
    {
      "id": "insight",
      "name": "Insight",
      "description": "Đọc số liệu, tìm cơ hội.",
      "kind": "group",
      "group": "team-insight",
      "soots": [
        {
          "id": "analyst",
          "role": "analyst"
        },
        {
          "id": "radar",
          "role": "radar"
        }
      ],
      "takes_in": [
        {
          "from": "marketing",
          "what": "bài đã đăng và số liệu của bài (metrics, posts)",
          "contract": "marketing-numbers"
        },
        {
          "from": "cs",
          "what": "ý kiến độc giả đã gom (voc)",
          "contract": "cs-voc",
          "optional": true
        },
        {
          "from": "build",
          "what": "tình trạng phát hành của cơ hội đã duyệt",
          "contract": "build-state"
        }
      ],
      "gives_out": [
        {
          "table": "opportunities",
          "pack": "company-loop",
          "fields": [
            "ref",
            "title",
            "kind",
            "query",
            "state",
            "target_outcome",
            "expected_delta"
          ],
          "note": "xếp hạng mỗi tuần; cơ hội sản phẩm do người sáng lập quyết"
        },
        {
          "table": "topics",
          "pack": "company-loop",
          "fields": [
            "query",
            "reason",
            "opportunity_ref",
            "kind",
            "state"
          ],
          "note": "chủ đề nội dung để Marketing viết tiếp"
        },
        {
          "table": "scoreboard",
          "pack": "company-loop",
          "fields": [
            "key",
            "period_from",
            "period_to",
            "metrics",
            "cohorts",
            "plans"
          ],
          "note": "số liệu của sản phẩm, mỗi tuần một dòng"
        },
        {
          "table": "handoffs",
          "pack": "company-loop",
          "fields": [
            "opportunity",
            "requirement_path",
            "state",
            "ticket",
            "released_at"
          ],
          "note": "yêu cầu làm sản phẩm và tình trạng"
        }
      ],
      "decides": {
        "alone": [
          "xếp hạng và xếp hàng chủ đề nội dung",
          "radar đọc những nguồn nào",
          "đề xuất cách chia ngân sách"
        ],
        "with_founder": [
          "một cơ hội sản phẩm (Go, Để sau, Bỏ)",
          "mục tiêu",
          "mọi thay đổi ngân sách mỗi ngày của một nhóm"
        ]
      },
      "daily_tokens": 130000,
      "escalates_when": [
        {
          "when": "một khóa bảng số liệu bị từ chối hoặc sản phẩm không trả số liệu",
          "on": "input_starving",
          "after": "24h"
        },
        {
          "when": "độc giả đang chờ một người trả lời",
          "on": "queue_waiting"
        },
        {
          "when": "một cơ hội đã chờ người sáng lập một tuần",
          "on": "queue_waiting",
          "after": "168h"
        }
      ],
      "lead": true
    },
    {
      "id": "marketing",
      "name": "Marketing",
      "description": "Viết nội dung từ chủ đề.",
      "kind": "group",
      "group": "team-marketing",
      "soots": [
        {
          "id": "writer",
          "role": "writer"
        },
        {
          "id": "publisher",
          "role": "publisher"
        }
      ],
      "takes_in": [
        {
          "from": "insight",
          "what": "chủ đề nội dung cần viết",
          "contract": "topics"
        }
      ],
      "gives_out": [
        {
          "table": "posts",
          "pack": "marketing",
          "fields": [
            "ref",
            "kind",
            "channel",
            "title",
            "link",
            "state",
            "url"
          ],
          "note": "bản ghi duy nhất về việc đã viết và đã đăng"
        },
        {
          "table": "metrics",
          "pack": "marketing",
          "fields": [
            "url",
            "source",
            "day",
            "views",
            "likes",
            "comments",
            "impressions",
            "clicks"
          ],
          "note": "số liệu Search Console, TikTok và YouTube"
        },
        {
          "table": "signals",
          "pack": "marketing",
          "fields": [
            "source",
            "title",
            "url",
            "state",
            "note",
            "ref"
          ],
          "note": "tín hiệu thị trường radar đã giữ"
        }
      ],
      "decides": {
        "alone": [
          "viết và lên lịch trong các bước kiểm tra và giới hạn",
          "tạm dừng một kênh"
        ],
        "with_founder": [
          "đăng bài khi còn yêu cầu publish_approval",
          "một kênh mới hoặc một lần đăng nhập",
          "mọi việc liên quan đến tiền hoặc tài khoản"
        ]
      },
      "daily_tokens": 250000,
      "escalates_when": [
        {
          "when": "một kênh bị đăng xuất",
          "on": "chain_failed"
        },
        {
          "when": "một bài trễ quá stale_after_h",
          "on": "queue_waiting"
        },
        "một phản hồi nói về tiền, tài khoản hoặc khiếu nại"
      ]
    },
    {
      "id": "cs",
      "name": "Hỗ trợ",
      "description": "Trả lời độc giả, gom phản hồi.",
      "kind": "external",
      "group": "",
      "soots": [
        {
          "id": "support",
          "role": "answers readers"
        },
        {
          "id": "desk",
          "role": "sorts feedback"
        }
      ],
      "takes_in": [
        {
          "from": "insight",
          "what": "chỗ thiếu kiến thức mà bản tổng hợp tìm thấy",
          "optional": true
        }
      ],
      "gives_out": [
        {
          "table": "voc",
          "pack": "lohi-cs",
          "fields": [
            "kind",
            "summary",
            "created"
          ],
          "note": "điều độc giả đã hỏi, báo hoặc muốn"
        }
      ],
      "decides": {
        "alone": [
          "trả lời dựa trên dữ kiện",
          "ghi nhận phản hồi"
        ],
        "with_founder": [
          "hoàn tiền, tài khoản và khiếu nại chuyển cho một người"
        ]
      },
      "daily_tokens": 0,
      "escalates_when": [
        "một độc giả đang chờ một người"
      ],
      "external": {
        "runtime": "cs-server",
        "note": "chỉ khai báo, setup không triển khai; xem nhóm hỗ trợ"
      },
      "optional": true
    },
    {
      "id": "financial",
      "name": "Tài chính",
      "description": "Theo dõi doanh thu và chi phí.",
      "kind": "group",
      "group": "team-financial",
      "soots": [
        {
          "id": "finance",
          "role": "finance"
        }
      ],
      "takes_in": [
        {
          "from": "insight",
          "what": "dòng bảng số liệu về doanh thu, nhóm người dùng và gói",
          "contract": "scoreboard"
        }
      ],
      "gives_out": [
        {
          "event": "weekly_finance_report",
          "note": "báo cáo tài chính hằng tuần, chỉ đọc; company-loop không có bảng báo cáo"
        }
      ],
      "decides": {
        "alone": [
          "viết báo cáo hằng tuần"
        ],
        "with_founder": [
          "không bao giờ tự động xử lý tiền: mọi thay đổi do người sáng lập quyết"
        ]
      },
      "daily_tokens": 30000,
      "escalates_when": [
        "doanh thu giảm hai tuần liên tiếp",
        {
          "when": "chi phí Soot của một nhóm tăng nhanh hơn kết quả nhóm làm ra",
          "on": "budget_80"
        }
      ],
      "optional": true
    },
    {
      "id": "build",
      "name": "Build",
      "description": "Làm sản phẩm.",
      "kind": "external",
      "group": "",
      "soots": [
        {
          "id": "claude-code",
          "role": "builds a requirement"
        }
      ],
      "takes_in": [
        {
          "from": "insight",
          "what": "một tệp REQUIREMENT cùng một cơ hội sản phẩm đã duyệt",
          "contract": "build-request"
        }
      ],
      "gives_out": [
        {
          "table": "handoffs",
          "pack": "company-loop",
          "fields": [
            "opportunity",
            "state",
            "ticket",
            "released_at"
          ],
          "note": "tình trạng đã phát hành hoặc đang chờ phát hành"
        }
      ],
      "decides": {
        "alone": [
          "làm và kiểm tra trong phạm vi yêu cầu"
        ],
        "with_founder": [
          "lệnh phát hành"
        ]
      },
      "daily_tokens": 0,
      "escalates_when": [
        "một bản bàn giao đang chờ lệnh phát hành",
        "việc làm sản phẩm bị chặn"
      ],
      "external": {
        "runtime": "claude-code",
        "via": "bbs team",
        "note": "hiện chỉ là hợp đồng: company-loop viết yêu cầu và đọc tình trạng; không có gì ở đây triển khai Claude Code"
      }
    }
  ],
  "contracts": [
    {
      "id": "topics",
      "owner": "insight",
      "reader": "marketing",
      "table": "topics",
      "pack": "company-loop",
      "mode": "read",
      "fields": [
        "query",
        "reason",
        "opportunity_ref",
        "state"
      ]
    },
    {
      "id": "marketing-numbers",
      "owner": "marketing",
      "reader": "insight",
      "table": "metrics",
      "pack": "marketing",
      "mode": "read",
      "fields": [
        "url",
        "source",
        "day",
        "views",
        "likes",
        "comments",
        "impressions",
        "clicks"
      ]
    },
    {
      "id": "scoreboard",
      "owner": "insight",
      "reader": "financial",
      "table": "scoreboard",
      "pack": "company-loop",
      "mode": "read",
      "fields": [
        "period_from",
        "period_to",
        "metrics",
        "cohorts",
        "plans"
      ],
      "optional": true
    },
    {
      "id": "build-request",
      "owner": "insight",
      "reader": "build",
      "table": "handoffs",
      "pack": "company-loop",
      "mode": "write",
      "fields": [
        "opportunity",
        "requirement_path",
        "state"
      ],
      "optional": true
    },
    {
      "id": "build-state",
      "owner": "build",
      "reader": "insight",
      "table": "handoffs",
      "pack": "company-loop",
      "mode": "read",
      "fields": [
        "opportunity",
        "state",
        "ticket",
        "released_at"
      ],
      "optional": true
    },
    {
      "id": "cs-voc",
      "owner": "cs",
      "reader": "insight",
      "table": "voc",
      "pack": "lohi-cs",
      "mode": "read",
      "fields": [
        "kind",
        "summary",
        "created"
      ],
      "optional": true
    }
  ]
}
