{
  "api_version": "soot/v1",
  "id": "marketing",
  "use": [],
  "capabilities": {
    "radar": {
      "skills": [
        {
          "name": "marketing-radar",
          "description": "Watch the sources the audience reads, triage them and keep the team's signals table and brief current.",
          "file": "skills/radar.md"
        }
      ],
      "tools": [
        {
          "name": "radar_feeds",
          "title": "Xem nguồn radar",
          "description": "List the radar's sources (Reddit, Hacker News, dev.to, Medium, Lobsters, Product Hunt, vendor blogs, X searches) with when each was last read, its last error and how many new items it found.",
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "run": {
            "program": "soot",
            "args": [
              "tool-forward",
              "--binding-env",
              "MARKETING_HUB"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "marketing_hub",
            "timeout": "20s",
            "max_output_bytes": 131072,
            "secret_env": {
              "MARKETING_HUB": "{{cred:MARKETING_HUB}}"
            }
          }
        },
        {
          "name": "radar_scan",
          "title": "Quét nguồn radar",
          "description": "Read the sources that are due (each at most every 15 minutes; Reddit one feed per scan) and store new items once per URL. Returns the newest untriaged items. Not available from a customer conversation.",
          "parameters": {
            "type": "object",
            "properties": {
              "feeds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 48
                },
                "minItems": 1,
                "maxItems": 40,
                "description": "Feed ids from radar_feeds; omit for all."
              },
              "max_new": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "default": 30,
                "description": "How many new items to return."
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "run": {
            "program": "soot",
            "args": [
              "tool-forward",
              "--binding-env",
              "MARKETING_HUB"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "marketing_hub",
            "timeout": "20s",
            "max_output_bytes": 131072,
            "secret_env": {
              "MARKETING_HUB": "{{cred:MARKETING_HUB}}"
            }
          }
        },
        {
          "name": "radar_items",
          "title": "Xem tin radar",
          "description": "List radar items by triage status (default new), optionally by feed, an accent-insensitive text query, or the last N hours.",
          "parameters": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "new",
                  "kept",
                  "dismissed",
                  "used"
                ],
                "default": "new"
              },
              "feeds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 48
                },
                "minItems": 1,
                "maxItems": 40,
                "description": "Feed ids from radar_feeds; omit for all."
              },
              "query": {
                "type": "string",
                "maxLength": 100
              },
              "since_hours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 720
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50,
                "default": 25
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "run": {
            "program": "soot",
            "args": [
              "tool-forward",
              "--binding-env",
              "MARKETING_HUB"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "marketing_hub",
            "timeout": "20s",
            "max_output_bytes": 131072,
            "secret_env": {
              "MARKETING_HUB": "{{cred:MARKETING_HUB}}"
            }
          }
        },
        {
          "name": "radar_mark",
          "title": "Phân loại tin radar",
          "description": "Triage radar items in one call: each item kept (with the angle as note), dismissed, or used once written about. All or nothing: an unknown or repeated id changes none.",
          "parameters": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "description": "Every item to triage, each once.",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^RI-[0-9A-F]{8}$"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "new",
                        "kept",
                        "dismissed",
                        "used"
                      ]
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 500,
                      "description": "For a kept item: product, angle and why now, one line."
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 50
              }
            },
            "required": [
              "items"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "soot",
            "args": [
              "tool-forward",
              "--binding-env",
              "MARKETING_HUB"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "marketing_hub",
            "timeout": "20s",
            "max_output_bytes": 131072,
            "secret_env": {
              "MARKETING_HUB": "{{cred:MARKETING_HUB}}"
            }
          }
        }
      ]
    },
