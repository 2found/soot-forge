            "stdin": "context",
            "mode": "read",
            "resource": "marketing_hub",
            "timeout": "20s",
            "max_output_bytes": 131072,
            "secret_env": {
              "MARKETING_HUB": "{{cred:MARKETING_HUB}}"
            }
          }
