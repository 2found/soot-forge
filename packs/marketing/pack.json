{
  "api_version": "soot/v1",
  "id": "marketing",
  "use": [],
  "capabilities": {
    "coordinate": {
      "skills": [
        {
          "name": "marketing-coordinate",
          "description": "Coordinate the selected marketing team with durable evidence.",
          "file": "skills/coordinate.md"
        }
      ]
    },
    "radar": {
      "skills": [
        {
          "name": "marketing-radar",
          "description": "Gather bounded source material into a granted pool with provenance.",
          "file": "skills/radar.md"
        }
      ]
    },
    "create": {
      "skills": [
        {
          "name": "marketing-create",
          "description": "Write a cited draft using observed pool revisions.",
          "file": "skills/create.md"
        }
      ],
      "tools": [
        {
          "name": "draft",
          "description": "Save a cited draft with optimistic revision. A changed draft invalidates approvals.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "maxLength": 240
              },
              "body": {
                "type": "string",
                "maxLength": 12000
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "properties": {
                    "pool": {
                      "type": "string"
                    },
                    "document": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "pool",
                    "document",
                    "revision",
                    "url"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "expected_revision",
              "title",
              "body",
              "sources"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "node",
            "args": [
              "tools/marketing.mjs",
              "draft"
            ],
            "directory": ".",
            "stdin": "context",
            "mode": "write",
            "resource": "marketing_ledger",
            "timeout": "30s",
            "secret_env": {
              "MARKETING_TEAM": "{{cred:MARKETING_TEAM}}"
            }
          }
        }
      ]
    },
    "edit": {
      "skills": [
        {
          "name": "marketing-edit",
          "description": "Review drafts and plan only channels in the host-authorized collaborators.",
          "file": "skills/edit.md"
        }
      ],
      "tools": [
        {
          "name": "plan",
          "description": "Save a channel plan using host-authorized session publishers. Empty entries means draft-only. This does not schedule a job.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "entries": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "properties": {
                    "publisher": {
                      "type": "string"
                    },
                    "channel": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "timezone": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "publisher",
                    "channel",
                    "at",
                    "timezone"
                  ],
                  "additionalProperties": false
                }
              },
              "expected_plan_revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "expected_revision",
              "entries",
              "expected_plan_revision"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "node",
            "args": [
              "tools/marketing.mjs",
              "plan"
            ],
            "directory": ".",
            "stdin": "context",
            "mode": "write",
            "resource": "marketing_ledger",
            "timeout": "30s",
            "secret_env": {
              "MARKETING_TEAM": "{{cred:MARKETING_TEAM}}"
            }
          }
        }
      ]
    },
    "publish": {
      "skills": [
        {
          "name": "marketing-publish",
          "description": "Publish an approved exact revision once and reconcile uncertain outcomes.",
          "file": "skills/publish.md"
        }
      ],
      "tools": [
        {
          "name": "publish",
          "description": "Publish a due, approved revision to this Soot's bound channel gateway. Uncertain outcomes require reconciliation, never retry.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "channel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "expected_revision",
              "channel"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "node",
            "args": [
              "tools/marketing.mjs",
              "publish"
            ],
            "directory": ".",
            "stdin": "context",
            "mode": "write",
            "resource": "marketing_ledger",
            "timeout": "30s",
            "secret_env": {
              "MARKETING_TEAM": "{{cred:MARKETING_TEAM}}"
            }
          }
        },
        {
          "name": "reconcile",
          "description": "Read the original remote receipt for an uncertain send; never sends a post.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "channel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "expected_revision",
              "channel"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "node",
            "args": [
              "tools/marketing.mjs",
              "reconcile"
            ],
            "directory": ".",
            "stdin": "context",
            "mode": "read",
            "resource": "marketing_ledger",
            "timeout": "30s",
            "secret_env": {
              "MARKETING_TEAM": "{{cred:MARKETING_TEAM}}"
            }
          }
        }
      ]
    },
    "records": {
      "tools": [
        {
          "name": "inspect",
          "description": "Read one draft, revision, plan, approvals and publication receipts.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "node",
            "args": [
              "tools/marketing.mjs",
              "inspect"
            ],
            "directory": ".",
            "stdin": "context",
            "mode": "read",
            "resource": "marketing_ledger",
            "timeout": "30s",
            "secret_env": {
              "MARKETING_TEAM": "{{cred:MARKETING_TEAM}}"
            }
          }
        }
      ]
    }
  }
}
