        {
          "name": "cms_read",
          "title": "Đọc một bài CMS",
          "description": "Read the latest revision of a CMS post: body_markdown, revision, status and preview_url (a signed page showing exactly this revision, for anyone who reviews it before it goes live).",
          "parameters": {
