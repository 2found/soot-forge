        {
          "name": "cms_save",
          "title": "Lưu bản nháp CMS",
          "description": "Save a CMS draft revision; it never goes live (a publisher does that with cms_publish after reviewing it). New post: expected_revision 0. Edit: the revision cms_read returned. Body is Markdown, at most 40000 bytes. Returns preview_url for the reviewer.",
          "parameters": {
            "type": "object",
            "properties": {
              "site": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64,
                "description": "The hub's site id for a blog (social_channels lists this team's sites)."
              },
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 96,
                "description": "URL slug, lowercase words joined by single hyphens. Give each language its own slug (…-en, …-vi)."
              },
              "request_id": {
                "type": "string",
                "format": "uuid",
                "description": "A fresh UUID per change. Reuse it only to retry the exact same change after an unknown outcome."
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "summary": {
                "type": "string",
                "maxLength": 500,
                "description": "One or two sentences shown in blog lists and link previews."
              },
              "body_markdown": {
                "type": "string",
                "maxLength": 40000
              },
              "language": {
                "type": "string",
                "enum": [
                  "en",
                  "vi"
                ]
              }
            },
            "required": [
              "site",
              "slug",
              "request_id",
              "expected_revision",
              "title",
              "summary",
              "body_markdown",
              "language"
            ],
            "additionalProperties": false
          },
