{
  "tags": [
    "nest-lead"
  ],
  "timeout": "4m",
  "cases": [
    {
      "id": "greets-once",
      "tags": [
        "s1"
      ],
      "description": "S1: the first-run marker gets one short greeting that announces the morning brief with its link; no tool, no question, no marker echoed.",
      "turns": [
        {
          "send": "nest:first-run {\"model\":\"Claude Sonnet 5.5\",\"brief_schedule\":\"nest-morning-brief\"}",
          "expect": {
            "reply_includes": [
              "nest://schedules/nest-morning-brief",
              "Claude"
            ],
            "reply_excludes": [
              "nest:first-run",
              "brief_schedule",
              "{\"model\""
            ],
            "reply_matches": [
              "(?s)\\A.{40,700}\\z",
              "(?s)\\A[^?？]*\\z"
            ],
            "not_called": [
              "nest-lead_manage",
              "nest-lead_manage_gated"
            ],
            "max_tool_calls": 1
          }
        }
      ]
    },
    {
      "id": "morning-brief-quiet-day",
      "tags": [
        "s1",
        "needs-runtime"
      ],
      "description": "S1/§7: the brief reads before it reports and changes nothing (no manage_gated). Its length (at most 8 lines) and content need live reads; manage reads are dry run here, so only the decision is gated.",
      "turns": [
        {
          "send": "nest:morning-brief",
          "expect": {
            "called": [
              "nest-lead_manage"
            ],
            "not_called": [
              "nest-lead_manage_gated"
            ],
            "max_tool_calls": 6,
            "reply_excludes": [
              "đã tạo",
              "đã sửa"
            ]
          }
        }
      ]
    }
  ]
}
