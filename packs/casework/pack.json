{
  "api_version": "soot/v1",
  "id": "casework",
  "capabilities": {
    "records": {
      "skills": [
        {
          "file": "skill.md",
          "description": "Optional persistent records for work that needs tracking or handoff"
        }
      ],
      "tools": [
        {
          "name": "read",
          "run": {
            "program": "bin/soot-case",
            "args": [
              "read",
              "data"
            ],
            "stdin": "context",
            "resource": "casework_records",
            "timeout": "15s"
          },
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "name": "upsert",
          "run": {
            "program": "bin/soot-case",
            "args": [
              "upsert",
              "data"
            ],
            "stdin": "context",
            "resource": "casework_records",
            "mode": "write",
            "timeout": "15s"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "resolved"
                ]
              }
            },
            "required": [
              "title",
              "summary",
              "status"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "handoff",
          "run": {
            "program": "bin/soot-case",
            "args": [
              "handoff",
              "data"
            ],
            "stdin": "context",
            "resource": "casework_records",
            "mode": "write",
            "timeout": "15s"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "to": {
                "type": "string",
                "const": "human"
              }
            },
            "required": [
              "summary",
              "to"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  },
  "use": [
    "records"
  ]
}
