{
  "api_version": "soot/v1",
  "id": "image-gen",
  "name": "Image generation",
  "description": "Generate PNGs locally with Qwen Image 2.1 Turbo Q4_K_M and a host-owned Metal/CPU runtime.",
  "use": [],
  "capabilities": {
    "inspect": {
      "skills": [
        {
          "name": "image_gen_inspect",
          "file": "skills/inspect.md",
          "description": "Inspect actual PNG dimensions and alpha; does not judge prompt fidelity."
        }
      ],
      "tools": [
        {
          "name": "inspect",
          "description": "Inspect actual PNG dimensions and alpha; does not judge prompt fidelity.",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "tools/run",
            "args": [
              "inspect"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "file_workspace",
            "timeout": "2m",
            "secret_env": {
              "FILE_ROOT": "{{cred:FILE_ROOT}}",
              "PYTHON_EXECUTABLE": "{{cred:PYTHON_EXECUTABLE}}"
            }
          }
        }
      ]
    },
    "generate": {
      "skills": [
        {
          "name": "image_gen_generate",
          "file": "skills/generate.md",
          "description": "Generate one new PNG with the pinned Turbo Q4_K_M model, CFG=1 and its exact 8-step schedule. Never download or install dependencies."
        }
      ],
      "tools": [
        {
          "name": "generate",
          "description": "Generate one new PNG with the pinned Turbo Q4_K_M model, CFG=1 and its exact 8-step schedule. Never download or install dependencies.",
          "parameters": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "output": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "New PNG relative to FILE_ROOT; parent must exist."
              },
              "width": {
                "type": "integer",
                "minimum": 256,
                "maximum": 768,
                "description": "Multiple of 32; defaults 512. Host also limits total pixels."
              },
              "height": {
                "type": "integer",
                "minimum": 256,
                "maximum": 768
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "transparent": {
                "type": "boolean"
              }
            },
            "required": [
              "prompt",
              "output"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "tools/run",
            "args": [
              "generate"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "file_workspace",
            "timeout": "30m",
            "secret_env": {
              "FILE_ROOT": "{{cred:FILE_ROOT}}",
              "PYTHON_EXECUTABLE": "{{cred:PYTHON_EXECUTABLE}}",
              "IMAGE_GEN_BINDING": "{{cred:IMAGE_GEN_BINDING}}"
            }
          }
        }
      ]
    }
  }
}
