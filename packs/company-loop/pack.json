    {
      "name": "metrics_record",
      "title": "Ghi số liệu",
      "description": "Record a product's numbers for one period in this pack's own metrics table, for a company with no scoreboard address: a Soot that reads the numbers elsewhere (a sheet, a payment dashboard, a data table) writes them here, and the Công ty page shows them with their own labels, units and targets. One row per product, period and metric; writing again replaces it. Aggregate numbers only, never a person. Answers {ok, saved, period}.",
      "parameters": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "description": "The product id the numbers belong to."
          },
          "period": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "to": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "description": "The days the numbers cover (at most 31); absent is the last 7 full days."
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "value": {
                  "type": "number"
                },
                "previous": {
                  "type": "number",
                  "description": "The same number for the period before; absent: the page uses the previous period recorded here."
                },
                "label": {
                  "type": "string",
                  "maxLength": 40
                },
                "unit": {
                  "type": "string",
                  "maxLength": 12,
                  "description": "vnd, usd, percent, count, or a short suffix."
                },
                "good": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down"
                  ]
                },
                "target": {
                  "type": "number"
                },
                "north_star": {
                  "type": "boolean"
                }
              },
              "required": [
                "key",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "source": {
            "type": "string",
            "maxLength": 60,
            "description": "Where the numbers were read, in a few words."
          }
        },
        "required": [
          "product",
          "metrics"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "metrics_record"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "30s",
        "max_output_bytes": 65536
      }
    },
