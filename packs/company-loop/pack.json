{
  "api_version": "soot/v1",
  "id": "company-loop",
  "label": {
    "vi": "Công ty",
    "en": "Company loop"
  },
  "keywords": {
    "vi": [
      "công ty",
      "bản tin",
      "cơ hội",
      "số liệu",
      "vòng lặp"
    ],
    "en": [
      "company",
      "insight",
      "digest",
      "scoreboard",
      "loop"
    ]
  },
  "description": {
    "vi": "Vòng lặp công ty cho một sản phẩm: đọc bảng số, lập bản tin cơ hội mỗi tuần, nội dung tự chạy, sản phẩm chờ bạn bấm Go rồi bàn giao cho đội bbs:team và theo dõi đến khi phát hành.",
    "en": "A product-agnostic company loop: reads the scoreboard, makes a weekly digest of opportunities, sends content to marketing by itself, hands a founder-approved product change to bbs:team and watches it to release."
  },
  "needs": {
    "env": [
      "LOOP_SOOT_BIN",
      "LOOP_SOOT_CONFIG",
      "SCOREBOARD_URL",
      "PRODUCT_REPO",
      "BBS_BIN",
      "BBS_TEAM_AGENT",
      "CS_RUNTIME_URL",
      "SUPPORT_QUEUE_URL",
      "RELEASE_TAGS",
      "BABYSIT_HOME",
      "PATH",
      "HOME",
      "SCOREBOARD_URLS",
      "NORTH_STAR"
    ],
    "credentials": {
      "PRODUCT_ADMIN_KEY": {
        "title": "Khoá admin sản phẩm",
        "description": "Khoá API vai trò agent_mod của sản phẩm để đọc bảng số tổng hợp (không có dữ liệu cá nhân). Chỉ gửi tới địa chỉ SCOREBOARD_URL. Dùng chung khoá đã nhập cho marketing; nhập trong Nest, không nhập trong chat.",
        "from": "operator",
        "optional": true
      },
      "CS_RUNTIME_TOKEN": {
        "title": "Khoá runtime Hỗ trợ",
        "description": "Khoá vận hành của runtime Hỗ trợ (CS_RUNTIME_URL) để đọc những câu khách hỏi mà kho kiến thức chưa trả lời được và những điều bạn đọc muốn có (bàn ghi nhận). Tuỳ chọn: không có thì bản tin bỏ phần này. Nhập trong Nest, không nhập trong chat.",
        "from": "operator",
        "optional": true
      },
      "SCOREBOARD_KEYS": {
        "title": "Khoá bảng số theo sản phẩm",
        "description": "Mỗi sản phẩm một khoá: các dòng “mã-sản-phẩm=khoá” (xuống dòng hoặc dấu phẩy), dùng cho các địa chỉ trong SCOREBOARD_URLS. Khoá của sản phẩm nào chỉ gửi tới địa chỉ của sản phẩm đó; sản phẩm không có dòng riêng thì không gửi khoá. SCOREBOARD_URL đơn lẻ vẫn dùng PRODUCT_ADMIN_KEY. Nhập trong Nest, không nhập trong chat.",
        "from": "operator",
        "optional": true
      }
    }
  },
  "skills": [
    {
      "name": "company-digest",
      "description": "Weekly: rank at most five opportunities from the signals packet, customer evidence first, tag each with part (and awareness, moat, pain), save them with digest_save, end in one line (the Cần bạn card is kept by opportunities_card, not by you).",
      "file": "skills/digest.md"
    }
  ],
