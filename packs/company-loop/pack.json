            "type": "string",
            "maxLength": 300
          },
          "ticket": {
            "type": "string",
            "maxLength": 64
          },
          "host": {
            "type": "string",
            "maxLength": 64
          },
          "product": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "part": {
            "type": "string",
            "enum": [
