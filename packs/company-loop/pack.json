  "tools": [
    {
      "name": "scoreboard_sync",
      "title": "Đọc bảng số sản phẩm",
      "description": "Read the product scoreboard (SCOREBOARD_URL, contract version 1) for the last 7 full days, keep one row per period and append each finished week once to the 2build company baseline (bbs company scoreboard record). Without PRODUCT_ADMIN_KEY or SCOREBOARD_URL it answers a quiet skipped. A refused key is one plain line naming the role agent_mod. When 5 or more readers wait for a person (support.by_state.waiting_human) it answers one Cần bạn card request (raise) per count bucket (5, 10, 20, 50) with a link to SUPPORT_QUEUE_URL, kept current, and settles it once fewer than 5 wait. The runtime files the card; no model wakes. Answers {done: true}, or with for_digest the sync result for the digest chain.",
      "parameters": {
        "type": "object",
        "properties": {
          "for_digest": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "scoreboard_sync"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "60s",
        "max_output_bytes": 65536,
        "secret_env": {
          "PRODUCT_ADMIN_KEY": "{{cred:PRODUCT_ADMIN_KEY}}",
          "SCOREBOARD_KEYS": "{{cred:SCOREBOARD_KEYS}}"
        }
      }
    },
    {
      "name": "signals",
      "title": "Gói tín hiệu cho bản tin",
      "description": "The compact packet (at most 3 KiB) the weekly digest reads: metric changes against the previous period, top sources, why support handed over, CS knowledge gaps, opportunities and decisions with actual_delta, last launches. Reader feedback comes from the team contract item cs.voc, which the digest reads with the data tool first and reports with voc: true; only when voc is unavailable (voc false or omitted) the packet falls back to the legacy feedback desk scrape (counts by kind plus up to 5 scrubbed samples each, at most 1 KiB, needs CS_RUNTIME_TOKEN). Wakes the Lead in a chain. The packet also carries parts [{p, st ok|hong|chua_do, m metric, pct, own team id or null}] (a hong or unowned part is evidence), moats (count of Go decisions by moat) and awareness (content topics by level over 8 weeks). Optional product narrows everything to one product.",
      "parameters": {
        "type": "object",
        "properties": {
          "voc": {
            "type": "boolean",
            "description": "true when cs.voc answered with rows (the digest has the feedback already); false or omitted when it was refused, empty-because-unreachable or not granted: the legacy desk scrape runs instead."
          },
          "product": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "description": "A product id: build the packet from that product board and narrow opportunities, decisions, handoffs and topics to it. Omitted: as before."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "signals"
        ],
        "stdin": "context",
        "mode": "read",
        "timeout": "45s",
        "max_output_bytes": 65536,
        "secret_env": {
          "CS_RUNTIME_TOKEN": "{{cred:CS_RUNTIME_TOKEN}}"
        }
      }
    },
    {
      "name": "digest_save",
      "title": "Lưu cơ hội của bản tin",
      "description": "Save 1-5 ranked opportunities (all or none): title, product, kind content|product, evidence_refs, signal_count, est_effort, est_value, confidence, target_outcome, expected_delta, check_after_days; content needs a Vietnamese query, product a summary. An item without target_outcome is refused. Content goes straight to a marketing topic (auto-go, logged by soot); product waits as proposed; the Cần bạn card for it is kept by opportunities_card, not here. Every item carries part (value|marketing|sales|delivery|finance); content needs awareness (unaware|problem|choosing), product needs pain (10-200 chars: who suffers from what); moat (scale|network|counter|switching|brand|cornered|process|none) is optional. The error names the missing field.",
      "parameters": {
        "type": "object",
        "properties": {
          "opportunities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 140
                },
                "product": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "content",
                    "product"
                  ]
                },
                "query": {
                  "type": "string",
                  "maxLength": 120,
                  "description": "content: a Vietnamese search phrase of 2+ words the audience types."
                },
                "summary": {
                  "type": "string",
                  "maxLength": 600,
                  "description": "product: what to build and why, 20+ chars."
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "minItems": 1,
                  "maxItems": 8
                },
                "signal_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "est_effort": {
                  "type": "string",
                  "maxLength": 40,
                  "description": "S, M, L or XL."
                },
                "est_value": {
                  "type": "string",
                  "maxLength": 40,
                  "description": "low, medium or high."
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "target_outcome": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{1,47}$",
                  "description": "A scoreboard metric key (signups, revenue_vnd, support_threads_new...) or a declared outcome id."
                },
                "expected_delta": {
                  "type": "number",
                  "description": "Expected change of the target over one 7-day window; negative to reduce. Not 0."
                },
                "check_after_days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 180
                },
                "part": {
                  "type": "string",
                  "enum": [
                    "value",
                    "marketing",
                    "sales",
                    "delivery",
                    "finance"
                  ],
                  "description": "The business part this change fixes or grows: value, marketing, sales, delivery or finance. Required."
                },
                "awareness": {
                  "type": "string",
                  "enum": [
                    "unaware",
                    "problem",
                    "choosing"
                  ],
                  "description": "Reader awareness the post speaks to: unaware (nấc 1, does not know the problem), problem (nấc 2, knows it, not how to solve) or choosing (nấc 3, picking whom to buy from). Required for content."
                },
                "moat": {
                  "type": "string",
                  "enum": [
                    "scale",
                    "network",
                    "counter",
                    "switching",
                    "brand",
                    "cornered",
                    "process",
                    "none"
                  ],
                  "description": "The moat this change builds (switching = the good kind: life easier, not lock-in). Optional; absent or none is honest."
                },
                "pain": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 200,
                  "description": "Who suffers from what, from customer evidence. Required for product; optional for content."
                },
                "goal": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
                  "description": "Optional. The id of the company goal this bet is meant to push (as the goal tool lists it). The loop only carries the id; it never reads goals."
                }
              },
              "required": [
                "title",
                "product",
                "kind",
                "evidence_refs",
                "signal_count",
                "est_effort",
                "est_value",
                "confidence",
                "target_outcome",
                "expected_delta",
                "check_after_days",
                "part"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "required": [
          "opportunities"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "digest_save"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "30s",
        "max_output_bytes": 65536
      }
    },
    {
      "name": "decide",
      "title": "Quyết định một cơ hội",
      "description": "Go, later or drop an opportunity and log it with the scoreboard value as baseline. A product Go writes docs/requirements/REQ-<id>.md in PRODUCT_REPO and spawns bbs team (never land or release); without bbs or Orca the handoff is draft_ready with the exact command. Needs the operator approval; the Công ty page does the same on the founder tap.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OP-[0-9A-F]{8}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "go",
              "later",
              "drop"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 300
