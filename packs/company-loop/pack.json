      "name": "page_action",
      "title": "Đổi trang Công ty",
      "description": "Công ty page action: go, later or drop an opportunity (a product Go is the founder approval), retry_handoff, task_done (a task recorded without a build stage is done: its outcome is measured from now), link_ticket (hidden manual override of the parent ticket id) or sync. host labels rows written before products with the server's product. Needs a request_id. part_set (founder only) sets the owner team, watching metric and promise of one part of a product; an empty string clears a field.",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "go",
              "later",
              "drop",
              "retry_handoff",
              "link_ticket",
              "sync",
              "task_done",
              "part_set"
            ]
          },
          "request_id": {
            "type": "string",
            "maxLength": 64
          },
          "id": {
            "type": "string",
            "pattern": "^OP-[0-9A-F]{8}$"
