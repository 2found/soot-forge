  "tools": [
    {
      "name": "scoreboard_sync",
      "title": "Đọc bảng số sản phẩm",
      "description": "Read the product scoreboard (SCOREBOARD_URL, contract version 1) for the last 7 full days, keep one row per period and append each finished week once to the 2build company baseline (bbs company scoreboard record). Without PRODUCT_ADMIN_KEY or SCOREBOARD_URL it answers a quiet skipped. A refused key is one plain line naming the role agent_mod. When 5 or more readers wait for a person (support.by_state.waiting_human) it answers one Cần bạn card request (raise) per count bucket (5, 10, 20, 50) with a link to SUPPORT_QUEUE_URL, kept current, and settles it once fewer than 5 wait. The runtime files the card; no model wakes. Answers {done: true}, or with for_digest the sync result for the digest chain.",
      "parameters": {
        "type": "object",
        "properties": {
          "for_digest": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "scoreboard_sync"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "60s",
        "max_output_bytes": 65536,
        "secret_env": {
          "PRODUCT_ADMIN_KEY": "{{cred:PRODUCT_ADMIN_KEY}}"
        }
      }
    },
    {
      "name": "signals",
      "title": "Gói tín hiệu cho bản tin",
      "description": "The compact packet (at most 3 KiB) the weekly digest reads: metric changes against the previous period, top sources, why support handed over, CS knowledge gaps and what readers asked for or lacked (counts by kind plus up to 5 scrubbed samples each, at most 1 KiB, from the feedback desk; both optional), opportunities and decisions with actual_delta, last launches. Wakes the Lead in a chain.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "signals"
        ],
        "stdin": "context",
        "mode": "read",
        "timeout": "45s",
        "max_output_bytes": 65536,
        "secret_env": {
          "CS_RUNTIME_TOKEN": "{{cred:CS_RUNTIME_TOKEN}}"
        }
      }
    },
    {
      "name": "digest_save",
      "title": "Lưu cơ hội của bản tin",
      "description": "Save 1-5 ranked opportunities (all or none): title, product, kind content|product, evidence_refs, signal_count, est_effort, est_value, confidence, target_outcome, expected_delta, check_after_days; content needs a Vietnamese query, product a summary. An item without target_outcome is refused. Content goes straight to a marketing topic (auto-go, logged by soot); product waits as proposed; the Cần bạn card for it is kept by opportunities_card, not here.",
      "parameters": {
        "type": "object",
        "properties": {
          "opportunities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 140
                },
                "product": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "content",
                    "product"
                  ]
                },
                "query": {
                  "type": "string",
                  "maxLength": 120,
                  "description": "content: a Vietnamese search phrase of 2+ words the audience types."
                },
                "summary": {
                  "type": "string",
                  "maxLength": 600,
                  "description": "product: what to build and why, 20+ chars."
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "minItems": 1,
                  "maxItems": 8
                },
                "signal_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "est_effort": {
                  "type": "string",
                  "maxLength": 40,
                  "description": "S, M, L or XL."
                },
                "est_value": {
                  "type": "string",
                  "maxLength": 40,
                  "description": "low, medium or high."
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "target_outcome": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{1,47}$",
                  "description": "A scoreboard metric key (signups, revenue_vnd, support_threads_new...) or a declared outcome id."
                },
                "expected_delta": {
                  "type": "number",
                  "description": "Expected change of the target over one 7-day window; negative to reduce. Not 0."
                },
                "check_after_days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 180
                }
              },
              "required": [
                "title",
                "product",
                "kind",
                "evidence_refs",
                "signal_count",
                "est_effort",
                "est_value",
                "confidence",
                "target_outcome",
                "expected_delta",
                "check_after_days"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "required": [
          "opportunities"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "digest_save"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "30s",
        "max_output_bytes": 65536
      }
    },
    {
      "name": "decide",
      "title": "Quyết định một cơ hội",
      "description": "Go, later or drop an opportunity and log it with the scoreboard value as baseline. A product Go writes docs/requirements/REQ-<id>.md in PRODUCT_REPO and spawns bbs team (never land or release); without bbs or Orca the handoff is draft_ready with the exact command. Needs the operator approval; the Công ty page does the same on the founder tap.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OP-[0-9A-F]{8}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "go",
              "later",
              "drop"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "id",
          "decision"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "decide"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "90s",
        "max_output_bytes": 65536,
        "approval": "operator"
      }
    },
    {
      "name": "topic_next",
      "title": "Chủ đề marketing kế tiếp",
      "description": "The oldest queued marketing topic {query, reason, opportunity_ref}, marked handed (given to marketing, not yet written), or {}. With chain: true only {query}, at most one a day, to merge into marketing plan.",
      "parameters": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "topic_next"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "30s",
        "max_output_bytes": 65536
      }
    },
    {
      "name": "topic_sync",
      "title": "Đối chiếu chủ đề với bài đã viết",
      "description": "Chain step after marketing plan (input_from previous): a handed topic whose keyword now has a post becomes written with the post id; one whose 48 h hold ended with no post returns to the queue. Passes marketing's output through unchanged.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "topic_sync"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "30s",
        "max_output_bytes": 65536
      }
    },
    {
      "name": "team_watch",
      "title": "Theo dõi đội dựng",
      "description": "Read bbs team snapshot for each open handoff with no model; the parent ticket is found from the team id (bbs ticket find), `starting` until the kickoff creates it. A handover waiting for the release go returns one raise (Cần bạn card) that the runtime files, and settles it when the go is given. A released team returns outcomes requirement_shipped to record and queues one launch topic; nothing changed answers {done: true}.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "team_watch"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "120s",
        "max_output_bytes": 65536
      }
    },
    {
      "name": "review",
      "title": "Chấm kết quả quyết định",
      "description": "For go decisions past check_after_days fill actual_delta from the scoreboard (the target_outcome key is the metric) and return the hit rate: a hit is actual at least half of expected.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "review"
        ],
        "stdin": "context",
        "mode": "write",
        "timeout": "30s",
        "max_output_bytes": 65536
      }
    },
    {
      "name": "opportunities_card",
      "title": "Thẻ cơ hội chờ bạn chọn",
      "description": "Tool-only, no model. Keep the one Cần bạn card for the product opportunities still proposed: raise answers it for the runtime to file (id = the waiting set, count current, link nest://page/cong-ty); settle answers it once none is proposed. Đã xem only acknowledges.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "opportunities_card"
        ],
        "stdin": "context",
        "mode": "read",
        "timeout": "30s",
        "max_output_bytes": 65536
      }
    },
    {
      "name": "health_sync",
      "title": "Sức khoẻ vòng lặp",
      "description": "Read-only. Keep the loop-health view: per stage (insight, build, marketing, CS) the last run, tokens spent in 7 days and the starving inputs, plus the founder's effort. Takes marketing_inputs_health as its input (input_from previous); asks the workspace's soot CLI (LOOP_SOOT_CONFIG) for runs. No model.",
      "parameters": {
        "type": "object",
        "properties": {
          "inputs": {"type": "array", "maxItems": 20, "items": {"type": "object", "properties": {"key": {"type": "string", "maxLength": 24}, "label": {"type": "string", "maxLength": 60}, "starving": {"type": "boolean"}, "detail": {"type": "string", "maxLength": 400}, "rows": {"type": "integer"}}, "additionalProperties": false}},
          "posts": {"type": "object", "additionalProperties": true},
          "daily_report": {"type": "object", "additionalProperties": true},
          "stages": {"type": "array", "maxItems": 8, "items": {"type": "object", "properties": {"key": {"type": "string", "maxLength": 24}, "label": {"type": "string", "maxLength": 60}, "schedules": {"type": "array", "items": {"type": "string", "maxLength": 64}, "maxItems": 40}, "prefixes": {"type": "array", "items": {"type": "string", "maxLength": 32}, "maxItems": 10}, "external": {"type": "boolean"}}, "required": ["key"], "additionalProperties": false}}
        },
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": ["tools/loop.mjs", "health_sync"],
        "stdin": "context",
        "mode": "write",
        "timeout": "90s",
        "max_output_bytes": 65536
      }
    },
    {
      "name": "page_view",
      "title": "Xem trang Công ty",
      "description": "Công ty page model: scoreboard tiles with deltas, opportunities, handoffs, decision log, hit rate and the one next step.",
      "parameters": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string",
            "enum": [
              "cong-ty"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/loop.mjs",
          "page_view"
        ],
        "stdin": "context",
        "mode": "read",
        "timeout": "20s",
        "max_output_bytes": 1048576
      }
    },
    {
      "name": "page_action",
      "title": "Đổi trang Công ty",
      "description": "Công ty page action: go, later or drop an opportunity (a product Go is the founder approval), retry_handoff, link_ticket (hidden manual override of the parent ticket id) or sync. Needs a request_id.",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "go",
              "later",
              "drop",
              "retry_handoff",
              "link_ticket",
              "sync"
            ]
          },
          "request_id": {
            "type": "string",
            "maxLength": 64
          },
          "id": {
            "type": "string",
            "pattern": "^OP-[0-9A-F]{8}$"
          },
          "note": {
            "type": "string",
            "maxLength": 300
          },
          "ticket": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "op",
          "request_id"
        ],
        "additionalProperties": false
      },
