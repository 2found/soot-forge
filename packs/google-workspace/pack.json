    {
      "name": "sheets_read",
      "description": "Read a bounded A1 rectangle; FORMULA reads return a snapshot for preflight-guarded writes.",
      "parameters": {
        "type": "object",
        "properties": {
          "spreadsheet_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Google resource ID, not URL"
          },
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Explicit bounded A1 range with tab, e.g. 'Chi phí'!A1:C20; at most 2000 cells."
          },
          "render": {
            "type": "string",
            "enum": [
              "FORMULA",
              "FORMATTED_VALUE",
              "UNFORMATTED_VALUE"
            ]
          }
        },
        "required": [
          "spreadsheet_id",
          "range"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "tools/run",
        "args": [
          "sheets_read"
        ],
        "stdin": "context",
        "mode": "read",
        "resource": "file_workspace",
        "timeout": "90s",
        "secret_env": {
          "FILE_ROOT": "{{cred:FILE_ROOT}}",
          "PYTHON_EXECUTABLE": "{{cred:PYTHON_EXECUTABLE}}",
          "GOOGLE_WORKSPACE_BINDING": "{{cred:GOOGLE_WORKSPACE_BINDING}}"
        }
      }
    },
    {
      "name": "sheets_create",
      "description": "Create spreadsheet with 1..20 named tabs. Stable action receipt prevents local duplicate creation.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Google resource ID, not URL"
          },
          "tabs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Tab title"
            },
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Stable action ID: letters, digits, underscore or hyphen. Unknown actions are never resent."
          }
        },
        "required": [
          "title",
          "action_id"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "tools/run",
        "args": [
          "sheets_create"
        ],
        "stdin": "context",
        "mode": "write",
        "resource": "file_workspace",
        "timeout": "90s",
        "secret_env": {
          "FILE_ROOT": "{{cred:FILE_ROOT}}",
          "PYTHON_EXECUTABLE": "{{cred:PYTHON_EXECUTABLE}}",
          "GOOGLE_WORKSPACE_BINDING": "{{cred:GOOGLE_WORKSPACE_BINDING}}"
        }
      }
    },
    {
      "name": "sheets_update",
      "description": "Update an exact A1 rectangle from values JSON after checking the FORMULA snapshot. Preflight is non-atomic; no server revision lock is claimed.",
      "parameters": {
        "type": "object",
        "properties": {
          "spreadsheet_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Google resource ID, not URL"
          },
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Explicit bounded A1 range with tab, e.g. 'Chi phí'!A1:C20; at most 2000 cells."
          },
          "spec": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Clean FILE_ROOT-relative path. Outputs must be new and parents must exist."
          },
          "expected_snapshot": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Stable action ID: letters, digits, underscore or hyphen. Unknown actions are never resent."
          }
        },
        "required": [
          "spreadsheet_id",
          "range",
          "spec",
          "expected_snapshot",
          "action_id"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "tools/run",
        "args": [
          "sheets_update"
        ],
        "stdin": "context",
        "mode": "write",
        "resource": "file_workspace",
        "timeout": "90s",
        "secret_env": {
          "FILE_ROOT": "{{cred:FILE_ROOT}}",
          "PYTHON_EXECUTABLE": "{{cred:PYTHON_EXECUTABLE}}",
          "GOOGLE_WORKSPACE_BINDING": "{{cred:GOOGLE_WORKSPACE_BINDING}}"
        }
      }
    },
