{
  "api_version": "soot/v1",
  "id": "google-workspace",
  "name": "Google Workspace",
  "description": "Work with Google Docs, Sheets and Drive through scoped REST tools, bounded files and durable action receipts.",
  "skills": [
    {
      "name": "google_workspace_read",
      "file": "skills/read.md",
      "description": "Read Docs tabs, revision IDs and bounded Drive document listings."
    },
    {
      "name": "google_workspace_write",
      "file": "skills/write.md",
      "description": "Create and edit Docs with durable action receipts and required revision IDs."
    },
    {
      "name": "google_workspace_spec",
      "file": "SPEC.md",
      "description": "Exact JSON schemas, examples, limits and failure semantics for the pack tools."
    },
    {
      "name": "google_workspace_export",
      "file": "skills/export.md",
      "description": "Export Google Docs to bounded PDF, Word or text files."
    },
    {
      "name": "google_workspace_sheets_read",
      "file": "skills/sheets.md",
      "description": "Read real spreadsheet tabs and bounded cell ranges; distinguish formulas, formatted and raw values."
    },
    {
      "name": "google_workspace_sheets_read_spec",
      "file": "SPEC.md",
      "description": "Exact supported Google Workspace schemas, limits, scopes and retry semantics."
    },
    {
      "name": "google_workspace_sheets_write",
      "file": "skills/sheets.md",
      "description": "Create Sheets, write exact rectangles and append rows with durable receipts and honest concurrency limits."
    },
    {
      "name": "google_workspace_sheets_write_spec",
      "file": "SPEC.md",
      "description": "Exact supported Google Workspace schemas, limits, scopes and retry semantics."
    },
    {
      "name": "google_workspace_drive_read",
      "file": "skills/drive.md",
      "description": "List paginated visible files/folders and read metadata without arbitrary query or full-Drive scope."
    },
    {
      "name": "google_workspace_drive_read_spec",
      "file": "SPEC.md",
      "description": "Exact supported Google Workspace schemas, limits, scopes and retry semantics."
    },
    {
      "name": "google_workspace_drive_download",
      "file": "skills/drive.md",
      "description": "Download binary files or export Google-native files into new bounded local artifacts."
    },
    {
      "name": "google_workspace_drive_download_spec",
      "file": "SPEC.md",
      "description": "Exact supported Google Workspace schemas, limits, scopes and retry semantics."
    },
    {
      "name": "google_workspace_drive_write",
      "file": "skills/drive.md",
      "description": "Create folders, upload small files, rename/move files using explicit actions; parent permissions may apply."
    },
    {
      "name": "google_workspace_drive_write_spec",
      "file": "SPEC.md",
      "description": "Exact supported Google Workspace schemas, limits, scopes and retry semantics."
    }
  ],
  "tools": [
    {
      "name": "docs_list",
      "description": "List visible Google Docs with Drive pagination. No sharing or full-drive read scope implied.",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "page_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Opaque Drive nextPageToken"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "tools/run",
        "args": [
          "docs_list"
        ],
        "stdin": "context",
        "mode": "read",
        "resource": "file_workspace",
        "timeout": "60s",
        "secret_env": {
          "FILE_ROOT": "{{cred:FILE_ROOT}}",
          "GOOGLE_WORKSPACE_BINDING": "{{cred:GOOGLE_WORKSPACE_BINDING}}",
          "PYTHON_EXECUTABLE": "{{cred:PYTHON_EXECUTABLE}}"
        }
      }
    },
    {
      "name": "docs_read",
      "description": "Read selected tab content and current revision. API indexes are UTF-16 code units.",
      "parameters": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Google document ID, not URL"
          },
          "tab_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Tab ID returned by read"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "document_id"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "tools/run",
        "args": [
          "docs_read"
        ],
        "stdin": "context",
        "mode": "read",
        "resource": "file_workspace",
        "timeout": "60s",
        "secret_env": {
          "FILE_ROOT": "{{cred:FILE_ROOT}}",
          "GOOGLE_WORKSPACE_BINDING": "{{cred:GOOGLE_WORKSPACE_BINDING}}",
          "PYTHON_EXECUTABLE": "{{cred:PYTHON_EXECUTABLE}}"
        }
      }
    },
    {
      "name": "docs_create",
      "description": "Create one private Google Doc with stable action_id. Duplicate successful actions return the stored receipt; pending actions require reconciliation.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Document title"
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Stable idempotency key, 1..64 letters/digits/_/-"
          }
        },
        "required": [
          "title",
          "action_id"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "tools/run",
        "args": [
          "docs_create"
        ],
        "stdin": "context",
        "mode": "write",
        "resource": "file_workspace",
        "timeout": "60s",
        "secret_env": {
          "FILE_ROOT": "{{cred:FILE_ROOT}}",
          "GOOGLE_WORKSPACE_BINDING": "{{cred:GOOGLE_WORKSPACE_BINDING}}",
          "PYTHON_EXECUTABLE": "{{cred:PYTHON_EXECUTABLE}}"
        }
      }
    },
    {
      "name": "docs_batch_update",
      "description": "Apply 1..100 Docs text/style/table requests from a JSON spec, with requiredRevisionId and explicit tab targeting. Never retries unknown outcomes.",
      "parameters": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Document ID"
          },
          "revision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Current revision from read"
          },
          "spec": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Clean path relative to host FILE_ROOT. Output parents must exist; outputs must be new."
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Stable action ID"
          }
        },
        "required": [
          "document_id",
          "revision_id",
          "spec",
          "action_id"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "tools/run",
        "args": [
          "docs_batch_update"
        ],
        "stdin": "context",
        "mode": "write",
        "resource": "file_workspace",
        "timeout": "60s",
        "secret_env": {
          "FILE_ROOT": "{{cred:FILE_ROOT}}",
          "GOOGLE_WORKSPACE_BINDING": "{{cred:GOOGLE_WORKSPACE_BINDING}}",
          "PYTHON_EXECUTABLE": "{{cred:PYTHON_EXECUTABLE}}"
        }
      }
    },
    {
      "name": "docs_export",
      "description": "Download one Drive export up to 10 MiB to a new local file.",
      "parameters": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
