{
  "api_version": "soot/v1",
  "id": "data-pool-console",
  "name": "Data pool console",
  "label": {
    "vi": "Kho tài liệu",
    "en": "Library"
  },
  "description": {
    "vi": "Kho tài liệu trong Nest: xem, tìm, thêm và sửa tài liệu Soot đọc khi trả lời, qua khoá giao diện của người quản lý.",
    "en": "The Library page in Nest: browse, search, add and edit the documents Soots read, through the operator interface key."
  },
  "keywords": {
    "vi": [
      "kho tài liệu",
      "tài liệu",
      "bộ sưu tập",
      "tri thức"
    ],
    "en": [
      "library",
      "documents",
      "collections",
      "knowledge"
    ]
  },
  "tools": [
    {
      "name": "view",
      "description": "Kho tài liệu page view (operator only): body {kind: overview|pools|query|activity|status, input}. Requires the host interface marker; unavailable to model calls.",
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "overview",
              "pools",
              "query",
              "activity",
              "status"
            ]
          },
          "input": {
            "type": "object"
          }
        },
        "required": [
          "kind",
          "input"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "soot",
        "args": [
          "tool-forward",
          "--binding-env",
          "DATA_POOL",
          "--",
          "view"
        ],
        "stdin": "context",
        "mode": "read",
        "resource": "data_pool",
        "timeout": "20s",
        "max_output_bytes": 131072,
        "secret_env": {
          "DATA_POOL": "{{cred:DATA_POOL_UI}}"
        }
      }
    },
    {
      "name": "action",
      "description": "Kho tài liệu page action (operator only): body {kind: write|manage, input} with request_id, revision and generation guards. Requires the host interface marker; unavailable to model calls.",
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "write",
              "manage"
            ]
          },
          "input": {
            "type": "object"
          }
        },
        "required": [
          "kind",
          "input"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "soot",
        "args": [
          "tool-forward",
          "--binding-env",
          "DATA_POOL",
          "--",
          "action"
        ],
        "stdin": "context",
        "mode": "write",
        "resource": "data_pool",
        "timeout": "20s",
        "max_output_bytes": 131072,
        "max_input_bytes": 32768,
        "secret_env": {
          "DATA_POOL": "{{cred:DATA_POOL_UI}}"
        }
      }
    }
  ],
  "needs": {
    "credentials": {
      "DATA_POOL_UI": {
        "title": "Khoá giao diện Data Pool",
        "description": "Binding của người quản lý cho giao diện Data Pool trong Nest (khác khoá của Soot). Người vận hành tạo theo hướng dẫn trong README của pack."
      }
    }
  },
  "interface": {
    "pieces": [
      {
        "id": "library",
        "slot": "data.tab",
        "label": {
          "vi": "Kho tài liệu",
          "en": "Library"
        },
        "icon": "library",
        "access": "operator",
        "bundle": "page/",
        "data": {
          "view_tool": "view",
          "action_tool": "action"
        },
        "provides": [
          "knowledge"
        ]
      }
    ]
  }
}
