{
  "api_version": "soot/v1",
  "id": "soot",
  "use": [
    "guide"
  ],
  "capabilities": {
    "guide": {
      "skills": [
        {
          "name": "soot-domain",
          "description": "Soot product domain, brand vocabulary, pack boundaries and pet lifecycle.",
          "file": "skills/domain/SKILL.md"
        }
      ]
    },
    "create-pet": {
      "skills": [
        {
          "name": "soot-create-pet",
          "description": "Create a new Soot pet or accessory variant using Codex imagegen handoff, seven animated states, sprite assembly and visual review.",
          "file": "skills/create-pet/SKILL.md"
        }
      ],
      "tools": [
        {
          "name": "pet_preflight",
          "description": "Check whether Codex CLI is installed and logged in on the Soot host. Returns user-facing setup steps; does not log in or generate images. Call before starting pet creation.",
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "run": {
            "program": "python3",
            "args": [
              "tools/pet.py",
              "preflight"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "soot_codex_status",
            "timeout": "20s",
            "env": [
              "PATH",
              "HOME",
              "CODEX_HOME"
            ]
          }
        },
        {
          "name": "pet_prepare",
          "description": "Check Codex login, then prepare seven grounded imagegen jobs. Returns blocked onboarding steps without creating files when Codex is unavailable or signed out.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$",
                "description": "Stable pet job id; a changed brief requires a new id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "accessories": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "Exact held object and worn accessories; replace the reference prop"
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "description": "Restrained hand interaction with the new object"
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Optional image path relative to host-bound SOOT_PET_STORE; defaults to bundled Soot identity"
              }
            },
            "required": [
              "id",
              "name",
              "accessories",
              "action"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "python3",
            "args": [
              "tools/pet.py",
              "prepare"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "soot_pet_store",
            "timeout": "2m",
            "secret_env": {
              "SOOT_PET_STORE": "{{cred:SOOT_PET_STORE}}"
            },
            "env": [
              "PATH",
              "HOME",
              "CODEX_HOME"
            ]
          }
        },
        {
          "name": "pet_inspect",
          "description": "List supplied and missing state sheets for a prepared pet.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$",
                "description": "Stable pet job id; a changed brief requires a new id"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "python3",
            "args": [
              "tools/pet.py",
              "inspect"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "soot_pet_store",
            "timeout": "2m",
            "secret_env": {
              "SOOT_PET_STORE": "{{cred:SOOT_PET_STORE}}"
            }
          }
        },
        {
          "name": "pet_assemble",
          "description": "Pack seven generated PNG sheets into a Soot v3 atlas, state sheets and motion previews; visual review remains required.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$",
                "description": "Stable pet job id; a changed brief requires a new id"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "run": {
            "program": "python3",
            "args": [
              "tools/pet.py",
              "assemble"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "soot_pet_store",
            "timeout": "2m",
            "secret_env": {
              "SOOT_PET_STORE": "{{cred:SOOT_PET_STORE}}"
            }
          }
        }
      ]
    },
    "configure": {
      "skills": [
        {
          "name": "configure_soot",
          "file": "skills/configure/SKILL.md"
        }
      ],
      "tools": [
        {
          "name": "configure",
          "description": "Read or edit your own Soot name, mascot, avatar, soul, mission and model tier. Existing Pack selections may be reduced; new grants require the operator. Changes apply after active work completes.",
          "parameters": {
            "type": "object",
            "properties": {
              "changes": {
                "type": "object",
                "description": "Omit or {} to inspect; editable keys: name, description, mascot, avatar, tier, packs, use, soul, mission",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "run": {
            "program": "soot",
            "args": [
              "configure",
              "--config",
              "../../deployment.json"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "soot_configuration",
            "timeout": "30s"
          }
        }
      ]
    }
  }
}
