{
  "api_version": "soot/v1",
  "id": "micro-fish",
  "label": {
    "vi": "Micro Fish: xã hội giả lập",
    "en": "Micro Fish"
  },
  "keywords": {
    "vi": [
      "khảo sát",
      "thử nghiệm",
      "giá",
      "quảng cáo",
      "ý tưởng"
    ],
    "en": [
      "simulation",
      "survey",
      "pricing",
      "campaign",
      "test"
    ]
  },
  "description": {
    "vi": "Xã hội giả lập: mỗi persona là một Soot riêng, cùng lướt một feed và tương tác với nhau, để thử nội dung, sản phẩm, giá hay chiến dịch.",
    "en": "A simulated society: every persona is its own Soot on a shared feed, reacting to each other, to test content, a product, a price or a campaign."
  },
  "skills": [
    {
      "name": "micro-fish-expert",
      "description": "Review a simulation's subjects through one named expert lens and record severity-ranked findings.",
      "file": "skills/expert.md"
    },
    {
      "name": "micro-fish-analyze",
      "description": "Turn a simulation tally into a decision report with evidence, segment differences and caveats.",
      "file": "skills/analyze.md"
    }
  ],
  "tools": [
    {
      "name": "timeline",
      "description": "Open your feed in a simulation: the posts you see this session, with likes, shares and recent comments from other people.",
      "parameters": {
        "type": "object",
        "properties": {
          "sim": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          }
        },
        "required": [
          "sim"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/micro-fish.mjs",
          "timeline"
        ],
        "directory": ".",
        "stdin": "context",
        "mode": "write",
        "resource": "micro-fish_world",
        "timeout": "45s"
      }
    },
    {
      "name": "act",
      "description": "Record what you did with every post in the feed you just opened: attention (skip, some, full), depth (the percent of the post you got through before moving on), like, share, follow, a comment, a quote post, and optionally a post of your own.",
      "parameters": {
        "type": "object",
        "properties": {
          "sim": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "reactions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "post": {
                  "type": "string"
                },
                "attention": {
                  "type": "string",
                  "enum": [
                    "skip",
                    "some",
                    "full"
                  ]
                },
                "depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Percent of the post you watched or read before moving on: 0-5 for an instant scroll, 100 only if you finished it."
                },
                "like": {
                  "type": "boolean"
                },
                "share": {
                  "type": "boolean"
                },
                "follow": {
                  "type": "boolean"
                },
                "comment": {
                  "type": "string",
                  "maxLength": 280
                },
                "quote": {
                  "type": "string",
                  "maxLength": 280
                }
              },
              "required": [
                "post",
                "attention",
                "depth"
              ],
              "additionalProperties": false
            }
          },
          "new_post": {
            "type": "string",
            "maxLength": 280
          }
        },
        "required": [
          "sim",
          "reactions"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/micro-fish.mjs",
          "act"
        ],
        "directory": ".",
        "stdin": "context",
        "mode": "write",
        "resource": "micro-fish_world",
        "timeout": "45s"
      }
    },
    {
      "name": "answer",
      "description": "Answer the interview questions about a post you met, keyed by question id: a 1–5 number, true/false, a list of short tags, or one or two sentences.",
      "parameters": {
        "type": "object",
        "properties": {
          "sim": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "answers": {
            "type": "object"
          }
        },
        "required": [
          "sim",
          "answers"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/micro-fish.mjs",
          "answer"
        ],
        "directory": ".",
        "stdin": "context",
        "mode": "write",
        "resource": "micro-fish_world",
        "timeout": "45s"
      }
    },
    {
      "name": "brief",
      "description": "Read a simulation's goal, platform and the full content of every subject under test.",
      "parameters": {
        "type": "object",
        "properties": {
          "sim": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          }
        },
        "required": [
          "sim"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/micro-fish.mjs",
          "brief"
        ],
        "directory": ".",
        "stdin": "context",
        "mode": "read",
        "resource": "micro-fish_world",
        "timeout": "45s"
      }
    },
    {
      "name": "expert",
      "description": "Record one expert's review of a simulation: the lens, findings ranked P0–P3 each with a fix, strengths, and what the lens could not judge.",
      "parameters": {
        "type": "object",
        "properties": {
          "sim": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "expert": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "lens": {
            "type": "string",
            "maxLength": 200
          },
          "findings": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "P0",
                    "P1",
                    "P2",
                    "P3"
                  ]
                },
                "subject": {
                  "type": "string"
                },
                "issue": {
                  "type": "string",
                  "maxLength": 300
                },
                "evidence": {
                  "type": "string",
                  "maxLength": 300
                },
                "fix": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": [
                "severity",
                "issue",
                "fix"
              ],
              "additionalProperties": false
            }
          },
          "strengths": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "coverage": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "sim",
          "expert",
          "lens",
          "findings",
          "coverage"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/micro-fish.mjs",
          "expert"
        ],
        "directory": ".",
        "stdin": "context",
        "mode": "write",
        "resource": "micro-fish_world",
        "timeout": "45s"
      }
    },
    {
      "name": "tally",
      "description": "Compute a simulation's deterministic statistics: per subject reach, attention, average depth (how far through people got), like, share, comment and follow rates with 95% intervals, rank among the other posts in the feed, A/B comparison, interview answers, a breakdown by segment, zone, sex or age, expert findings and warnings.",
      "parameters": {
        "type": "object",
        "properties": {
          "sim": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "by": {
            "type": "string",
            "enum": [
              "segment",
              "zone",
              "sex",
              "age"
            ]
          }
        },
        "required": [
          "sim"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/micro-fish.mjs",
          "tally"
        ],
        "directory": ".",
        "stdin": "context",
        "mode": "read",
        "resource": "micro-fish_world",
        "timeout": "45s"
      }
    },
    {
      "name": "status",
      "description": "List this workspace's simulations, or show one simulation's subjects, population and progress.",
      "parameters": {
        "type": "object",
        "properties": {
          "sim": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/micro-fish.mjs",
          "status"
        ],
        "directory": ".",
        "stdin": "context",
        "mode": "read",
        "resource": "micro-fish_world",
        "timeout": "45s"
      }
    },
    {
      "name": "profile",
      "description": "Read one persona of a simulation with every session, reaction, post and interview answer it recorded.",
      "parameters": {
        "type": "object",
        "properties": {
          "sim": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "persona": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          }
        },
        "required": [
          "sim",
          "persona"
        ],
        "additionalProperties": false
      },
      "run": {
        "program": "node",
        "args": [
          "tools/micro-fish.mjs",
          "profile"
        ],
        "directory": ".",
        "stdin": "context",
        "mode": "read",
        "resource": "micro-fish_world",
        "timeout": "45s"
      }
    }
  ]
}
