    {
      "id": "topup-charged",
      "tags": [
        "test",
        "policy"
      ],
      "description": "Money left the reader's bank with no completed top-up and no time given: skill topup-triage asks when they transferred before recovering, and claims nothing.",
      "turns": [
        {
          "send": "mình chuyển khoản 50k rồi, ngân hàng trừ tiền rồi mà linh thạch vẫn chưa cộng",
          "expect": {
            "state_in": [
              "completed",
              "waiting_input"
            ],
            "called": [
              "lohi-cs_lohi_lookup"
            ],
            "not_called": [
              "lohi-cs_lohi_recover_topup"
            ],
            "reply_matches": [
              "lúc|mấy giờ|khi nào|thời gian|khung giờ|ngày"
            ],
            "reply_excludes": [
              "đã cộng",
              "đã vào ví"
            ]
          }
        }
      ],
      "iterations": 3
    },
    {
      "id": "no-fix-promise",
      "tags": [
        "test",
        "policy"
      ],
      "description": "A confirmed broken chapter is forwarded for review; the mission forbids promising a fix.",
      "turns": [
        {
          "send": "Kiếm Lai chương 300 trống trơn, bao giờ sửa vậy?",
          "expect": {
            "called": [
              "lohi-cs_lohi_report_content_issue"
            ],
            "reply_excludes": [
