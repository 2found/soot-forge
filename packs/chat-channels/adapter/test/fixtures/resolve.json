      "method": "POST",
      "path": "/v1/channel/conversations/resolve",
      "body": {
        "request_id": "tg:7012345678:u:500120",
        "sender": { "id": "123456789" },
        "chat": { "id": "123456789", "kind": "dm" },
        "new": true
      }
    },
    "response": {
      "status": 200,
      "body": { "conversation": "chc_4d8e0b6a11", "created": true, "reply": "Đã mở cuộc trò chuyện mới với Đầu mối. Cuộc cũ vẫn còn trong Nest." }
    }
  },
  {
