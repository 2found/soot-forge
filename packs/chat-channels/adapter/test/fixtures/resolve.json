[
  {
    "name": "resolve: first message in a DM creates the mapping",
    "schema": { "request": "ResolveRequest", "response": "ResolveResult" },
    "request": {
      "method": "POST",
      "path": "/v1/channel/conversations/resolve",
      "body": {
        "request_id": "tg:7012345678:u:500110",
        "sender": { "id": "123456789" },
        "chat": { "id": "123456789", "kind": "dm" },
        "new": false
      }
    },
    "response": { "status": 200, "body": { "conversation": "chc_9f3a1c7e2b", "created": true } }
  },
  {
