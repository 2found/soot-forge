  {
    "name": "owner chat: the session of a revision-2 host carries the claim pattern",
    "schema": { "response": "Session" },
    "note": "Telegram binding. A revision ≤ 1 adapter ignores places (unknown field).",
    "request": {
      "method": "GET",
      "path": "/v1/channel/session",
      "headers": { "Authorization": "Bearer sca_fixture0000000000000000000000000000000000000" }
    },
    "response": {
      "status": 200,
      "body": {
        "contract": "channel-adapter.v1",
        "binding": { "id": "telegram", "platform": "telegram", "enabled": true },
        "soot": { "name": "Đầu mối" },
        "nest_url": null,
        "limits": { "text_bytes": 16384, "outbox_page": 100, "ack_batch": 100 },
        "pairing": { "code_pattern": "^[A-HJ-NP-Z2-9]{4}[- ]?[A-HJ-NP-Z2-9]{4}$" },
        "places": { "claim_pattern": "^/owner\\s+[A-HJ-NP-Z2-9]{4}[- ]?[A-HJ-NP-Z2-9]{4}$" },
        "copy": {
          "secret_warning": "Tin vừa rồi trông giống một khóa bí mật nên mình đã không đọc và không gửi đi. Đừng gửi khóa, mật khẩu hay mã 2FA qua đây — nhập chúng trong Nest.",
          "attachment_refused": "Hiện mình chưa nhận ảnh hay tệp qua đây. Bạn gửi trong Nest, hoặc mô tả bằng chữ nhé.",
          "too_long": "Tin quá dài. Bạn chia nhỏ ra giúp mình nhé.",
          "truncated": "… (còn tiếp)",
          "open_in_nest": "Mở Nest để xem đầy đủ.",
          "pair_in_dm": "Gửi mã ghép cặp trong tin nhắn riêng với bot, đừng gửi trong nhóm."
        }
      }
    }
  },
  {
    "name": "owner chat: the linked owner sends /owner with a fresh code in a group → designated (SF-8)",
    "schema": { "request": "PlaceClaim", "response": "PlaceClaimResult" },
    "note": "Nest → Kênh chat → telegram → Đặt kênh chủ sở hữu made QRST-UVWX a minute ago. The owner (123456789, linked) mentioned the bot with \"/owner QRST-UVWX\" in Đội vận hành. The host stores member_count 7 on owner_chat.",
    "request": {
      "method": "POST",
      "path": "/v1/channel/places/claim",
      "body": {
        "request_id": "tg:7012345678:u:600101",
        "sender": { "id": "123456789", "name": "Chủ shop" },
        "chat": { "id": "-1009876543210", "kind": "group", "title": "Đội vận hành", "member_count": 7 },
        "code": "QRST-UVWX"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "reply": "Đã đặt kênh này làm kênh chủ sở hữu. Mọi người trong kênh sẽ thấy tiêu đề và lựa chọn của việc cần duyệt.",
        "place": { "class": "owner_chat" }
      }
    }
  },
