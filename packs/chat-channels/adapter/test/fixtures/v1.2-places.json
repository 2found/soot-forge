[
  {
    "name": "v1.2 places: the first message in a guild channel creates the place conversation",
    "schema": { "request": "ResolveRequest", "response": "ResolveResult" },
    "note": "Discord binding, adapter revision 2. Hùng (unlinked) is the first to mention the bot in #help since the upgrade. The handle names the place (binding, chat), not the person: tenant channel:discord, origin live_chat.",
    "request": {
      "method": "POST",
      "path": "/v1/channel/conversations/resolve",
      "body": {
        "request_id": "dc:1100220033004400:m:1310000000000000001",
        "sender": { "id": "556677889900112233", "name": "Hùng" },
        "chat": { "id": "1288888888888888888", "kind": "guild_channel", "guild_id": "1277777777777777777", "title": "#help" },
        "new": false
      }
    },
    "response": { "status": 200, "body": { "conversation": "chc_pl1help0001", "created": true } }
  },
  {
    "name": "v1.2 places: a second person in the same channel gets the same handle",
