        "chat": { "id": "1288888888888888888", "kind": "guild_channel", "guild_id": "1277777777777777777" },
        "new": false
      }
    },
    "response": { "status": 200, "body": { "conversation": "chc_pl1help0001", "created": false } }
  },
  {
    "name": "v1.2 places: Hùng's message goes into the place conversation",
    "schema": { "request": "MemberMessage", "response": "MessageAccepted" },
    "note": "The host stores speaker {id: chs_5f1c0a9e3b7d2846a1c0e9f3, name: Hùng}; sender.username is never stored.",
    "request": {
      "method": "POST",
      "path": "/v1/channel/messages",
      "body": {
        "request_id": "dc:1100220033004400:m:1310000000000000003",
        "sender": { "id": "556677889900112233", "name": "Hùng", "username": "hung.dev" },
        "chat": { "id": "1288888888888888888", "kind": "guild_channel", "guild_id": "1277777777777777777" },
        "platform_message_id": "1310000000000000003",
        "text": "Bot ơi, gói Pro có xuất hoá đơn không?"
      }
    },
    "response": { "status": 202, "body": { "accepted": true, "duplicate": false, "conversation": "chc_pl1help0001" } }
  },
  {
    "name": "v1.2 places: minh's message lands in the same conversation as another speaker",
    "schema": { "request": "MemberMessage", "response": "MessageAccepted" },
    "note": "Two speakers, one conversation. Hùng's run is active, so minh's message is queued as minh's own run (steering S2), never absorbed into Hùng's.",
    "request": {
      "method": "POST",
      "path": "/v1/channel/messages",
      "body": {
        "request_id": "dc:1100220033004400:m:1310000000000000004",
        "sender": { "id": "223344556677889900", "name": "minh" },
        "chat": { "id": "1288888888888888888", "kind": "guild_channel", "guild_id": "1277777777777777777" },
        "platform_message_id": "1310000000000000004",
        "text": "Mình cũng muốn biết hạn thanh toán."
      }
    },
    "response": { "status": 202, "body": { "accepted": true, "duplicate": false, "conversation": "chc_pl1help0001" } }
  },
