{
  "api_version": "soot/v1",
  "id": "vibe_cf",
  "use": [],
  "capabilities": {
    "r2": {
      "skills": [
        {
          "name": "cloudflare_r2",
          "file": "skills/r2.md",
          "description": "Share files via presigned R2 URLs; upload artifact refs; revoke by deleting the object."
        }
      ],
      "tools": [
        {
          "name": "r2_share",
          "description": "Copy an artifact (or existing key) into R2 and return a presigned public GET URL with TTL<=24h.",
          "parameters": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "ttlSec": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "r2",
              "share"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_r2",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}",
              "ARTIFACT_STORE": "{{cred:ARTIFACT_STORE}}"
            }
          }
        },
        {
          "name": "r2_upload",
          "description": "Upload an artifact ref to R2 under a stable object key.",
          "parameters": {
            "type": "object",
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "r2",
              "upload"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_r2",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}",
              "ARTIFACT_STORE": "{{cred:ARTIFACT_STORE}}"
            }
          }
        },
        {
          "name": "r2_unshare",
          "description": "Delete an R2 object \u2014 every presigned URL to it dies.",
          "parameters": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string"
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "r2",
              "unshare"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_r2",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        },
        {
          "name": "r2_list",
          "description": "List objects in the bound R2 bucket.",
          "parameters": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string"
              },
              "max": {
                "type": "integer",
                "maximum": 1000
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "r2",
              "list"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "cf_r2",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        }
      ]
    },
    "worker": {
      "skills": [
        {
          "name": "cloudflare_worker",
          "file": "skills/worker.md",
          "description": "Deploy a single-file Worker and publish it on workers.dev; delete when done."
        }
      ],
      "tools": [
        {
          "name": "worker_deploy",
          "description": "Deploy a single-file Worker script (ES module) and enable its workers.dev route.",
          "parameters": {
            "type": "object",
            "required": [
              "name",
              "script"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
              },
              "script": {
                "type": "string",
                "maxLength": 1048576
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "worker",
              "deploy"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_workers",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        },
        {
          "name": "worker_delete",
          "description": "Delete a deployed Worker by name.",
          "parameters": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "worker",
              "delete"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_workers",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        },
        {
          "name": "worker_list",
          "description": "List deployed Workers.",
          "parameters": {
            "type": "object"
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "worker",
              "list"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "cf_workers",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        }
      ]
    },
    "d1": {
      "skills": [
        {
          "name": "cloudflare_d1",
          "file": "skills/d1.md",
          "description": "Create a D1 database and run bounded SQL; results come back as JSON rows."
        }
      ],
      "tools": [
        {
          "name": "d1_create",
          "description": "Create a D1 database; returns its uuid.",
          "parameters": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "d1",
              "create"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_d1",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        },
        {
          "name": "d1_exec",
          "description": "Run one SQL statement (<=8KiB) against a D1 database (uuid or name); returns JSON rows.",
          "parameters": {
            "type": "object",
            "required": [
              "database",
              "sql"
            ],
            "properties": {
              "database": {
                "type": "string",
                "maxLength": 64
              },
              "sql": {
                "type": "string",
                "maxLength": 8192
              },
              "params": {
                "type": "array"
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "d1",
              "exec"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_d1",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        },
        {
          "name": "d1_list",
          "description": "List D1 databases in the bound account.",
          "parameters": {
            "type": "object"
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "d1",
              "list"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "cf_d1",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        }
      ]
    },
    "dns": {
      "skills": [
        {
          "name": "cloudflare_dns",
          "file": "skills/dns.md",
          "description": "Point a hostname at a Worker or address: create/list/delete bounded DNS records in the bound zone."
        }
      ],
      "tools": [
        {
          "name": "dns_create",
          "description": "Create an A/AAAA/CNAME/TXT record in the bound zone.",
          "parameters": {
            "type": "object",
            "required": [
              "type",
              "name",
              "content"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "A",
                  "AAAA",
                  "CNAME",
                  "TXT"
                ]
              },
              "name": {
                "type": "string",
                "maxLength": 255
              },
              "content": {
                "type": "string",
                "maxLength": 1024
              },
              "ttl": {
                "type": "integer"
              },
              "proxied": {
                "type": "boolean"
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "dns",
              "create"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_dns",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        },
        {
          "name": "dns_delete",
          "description": "Delete a DNS record by id in the bound zone.",
          "parameters": {
            "type": "object",
            "required": [
              "record"
            ],
            "properties": {
              "record": {
                "type": "string",
                "maxLength": 64
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "dns",
              "delete"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_dns",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        },
        {
          "name": "dns_list",
          "description": "List DNS records in the bound zone.",
          "parameters": {
            "type": "object"
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "dns",
              "list"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "cf_dns",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        }
      ]
    },
    "shortlink": {
      "skills": [
        {
          "name": "cloudflare_shortlink",
          "file": "skills/shortlink.md",
          "description": "Mint short redirect links backed by a per-name Worker+D1 service on the bound account."
        }
      ],
      "tools": [
        {
          "name": "shortlink_setup",
          "description": "Provision a shortlink service: D1 '<worker>-links' db + links table + redirect worker on workers.dev. Idempotent.",
          "parameters": {
            "type": "object",
            "required": [
              "worker"
            ],
            "properties": {
              "worker": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$"
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "shortlink",
              "setup"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_workers",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        },
        {
          "name": "shortlink_mint",
          "description": "Mint a short link {worker}.{sub}.workers.dev/<code> redirecting to an https url, or to an artifact ref shared via R2 first.",
          "parameters": {
            "type": "object",
            "required": [
              "worker"
            ],
            "properties": {
              "worker": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "maxLength": 64
              },
              "ttlSec": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "shortlink",
              "mint"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_d1",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}",
              "ARTIFACT_STORE": "{{cred:ARTIFACT_STORE}}"
            }
          }
        },
        {
          "name": "shortlink_revoke",
          "description": "Delete a short link by code.",
          "parameters": {
            "type": "object",
            "required": [
              "worker",
              "code"
            ],
            "properties": {
              "worker": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "maxLength": 64
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "shortlink",
              "revoke"
            ],
            "stdin": "context",
            "mode": "write",
            "resource": "cf_d1",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        },
        {
          "name": "shortlink_list",
          "description": "List links for a shortlink service (most recent 100).",
          "parameters": {
            "type": "object",
            "required": [
              "worker"
            ],
            "properties": {
              "worker": {
                "type": "string"
              }
            }
          },
          "run": {
            "program": "bin/vibe-cf",
            "args": [
              "shortlink",
              "list"
            ],
            "stdin": "context",
            "mode": "read",
            "resource": "cf_d1",
            "secret_env": {
              "CF_BINDING": "{{cred:CF_BINDING}}"
            }
          }
        }
      ]
    }
  }
}