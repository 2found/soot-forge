{
  "api_version": "soot/v1",
  "id": "health",
  "label": {
    "vi": "Kiểm tra dịch vụ",
    "en": "Health checks"
  },
  "keywords": {
    "vi": [
      "kiểm tra",
      "sẵn sàng",
      "http",
      "giám sát"
    ],
    "en": [
      "health",
      "readiness",
      "http",
      "probe"
    ]
  },
  "description": {
    "vi": "Kiểm tra các dịch vụ đã sẵn sàng chưa qua địa chỉ HTTP do operator cấu hình.",
    "en": "Inspect readiness of operator-configured HTTP endpoints."
  },
  "skills": [
    {
      "file": "skill.md",
      "description": "Inspect readiness of the configured HTTP endpoints"
    }
  ],
  "tools": [
    {
      "name": "probe",
      "run": {
        "program": "tools/probe",
        "args": [
          "http://127.0.0.1:7788/healthz"
        ],
        "mode": "read",
        "timeout": "60s"
      }
    }
  ],
  "needs": {
    "env": [
      "HEALTH_TARGETS"
    ]
  }
}
